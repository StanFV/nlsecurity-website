---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const solutions = [
  { title: 'Objectbeveiliging', icon: '🏢', desc: 'Scherpe bewaking van uw panden en terreinen. Onze professionals zijn getraind om in te grijpen én weten preventief te handelen.' },
  { title: 'Alarmopvolging', icon: '🚨', desc: 'Razendsnelle opvolging en professioneel sleutelbeheer bij elke alarmmelding, 24/7 paraat.' },
  { title: 'Mobiele Surveillance', icon: '🚗', desc: 'Proactieve patrouilles en controlerondes om onregelmatigheden te voorkomen voordat ze ontstaan.' },
  { title: 'Verkeersregelaars', icon: '🚦', desc: 'Veilige doorstroming en professioneel verkeersbeheer bij bouwlocaties, evenementen en infrastructuur.' },
  { title: 'Receptiediensten', icon: '🛎️', desc: 'Het gastvrije gezicht van uw organisatie gecombineerd met een scherp oog voor veiligheid en toegangscontrole.' },
  { title: 'Brandwachten', icon: '🔥', desc: 'Gecertificeerd toezicht bij brandgevaarlijke werkzaamheden of bij uitval van uw brandmeldinstallatie.' },
  { title: 'Evenementen', icon: '🎪', desc: 'Veiligheid die bijdraagt aan de sfeer. Wij bewaken de rust zodat uw gasten zorgeloos kunnen genieten.' },
  { title: 'Aanbestedingen', icon: '📝', desc: 'Wij ondersteunen en adviseren bij complexe beveiligingsvraagstukken en aanbestedingstrajecten.' },
];
---

<BaseLayout title="Oplossingen">
  <Navigation />
  
  <main class="page-solutions">
    <section class="solutions-hero" style={`--hero-bg: url('${import.meta.env.BASE_URL}assets/images/Foto_Zuidas_Pak_1.png')`}>
      <div class="container text-center reveal">
        <span class="badge">Onze Diensten</span>
        <h1>Beveiliging <span class="gradient-text">op Maat</span></h1>
        <p class="lead max-700 mx-auto">De beveiligingsaanpak van NL Security richt zich vooral op preventief beveiligen. Voorkomen is immers beter dan genezen.</p>
      </div>
    </section>

    <section class="solutions-grid-elite bg-light">
      <div class="container grid grid-3">
        {solutions.map((sol, index) => (
          <div class="elite-card reveal" style={`transition-delay: ${index * 0.1}s`}>
            <div class="card-number">0{index + 1}</div>
            <h3>{sol.title}</h3>
            <p>{sol.desc}</p>
            <div class="card-footer">
              <a href={`${import.meta.env.BASE_URL}contact`} class="text-cta">Offerte aanvragen →</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="specialist-highlight">
      <div class="container grid grid-2 items-center">
        <div class="visual reveal">
          <img src={`${import.meta.env.BASE_URL}assets/images/Foto_zuidas_pak_5.png`} alt="Specialist" class="rounded-image shadow-lg" />
        </div>
        <div class="text reveal" style="transition-delay: 0.2s">
          <span class="badge">Heldere Analyse</span>
          <h2>Gratis <span class="orange-text">Presentatie</span></h2>
          <p>Goede beveiliging begint met een heldere analyse. Tijdens een (gratis) presentatie laten we u graag zien hoe onze diensten exact aansluiten bij uw behoefte. Onze analisten stellen kosteloos uw beveiligingsplan op.</p>
          <div class="actions-group">
            <a href={`${import.meta.env.BASE_URL}contact`} class="btn-glow">Afspraak Inplannen</a>
            <a href="tel:0880202800" class="btn-outline">Bel: 088 - 02 02 800</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  .text-center { text-align: center; }
  .bg-light { background-color: var(--bg-light); }
  .items-center { align-items: center; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .max-700 { max-width: 700px; }

  .solutions-hero {
    padding: 12rem 1rem 6rem;
    position: relative;
    background:
      linear-gradient(to bottom,
        rgba(255,255,255,0.62) 0%,
        rgba(255,255,255,0.72) 60%,
        rgba(255,255,255,0.88) 100%),
      var(--hero-bg) center 20% / cover no-repeat;
  }

  .solutions-hero h1 {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 768px) {
    .solutions-hero {
      padding: 7rem 1rem 3rem;
    }
    .solutions-hero h1 {
      font-size: 2.25rem;
    }
    .elite-card {
      padding: 2.5rem 1.5rem;
      border-radius: 28px;
    }
    .solutions-grid-elite {
      padding: 4rem 1rem;
    }
    .specialist-highlight {
      padding: 4rem 1rem;
    }
    .actions-group {
      flex-direction: column;
      gap: 1rem;
    }
    .btn-glow, .btn-outline {
      width: 100%;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .solutions-hero h1 { font-size: 1.9rem; }
    .elite-card h3 { font-size: 1.5rem; }
    .card-number { font-size: 1.1rem; }
  }

  .solutions-grid-elite {
    padding: 10rem 1rem;
    background: var(--brand-blue);
    position: relative;
  }

  .elite-card {
    background: rgba(255, 255, 255, 0.03);
    padding: 4.5rem 3.5rem;
    border-radius: 40px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .elite-card:hover {
    transform: translateY(-12px);
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--brand-orange);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }

  .card-number {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--brand-orange);
    margin-bottom: 2.5rem;
    display: inline-block;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--brand-orange);
    width: fit-content;
  }

  .elite-card h3 {
    font-size: 1.8rem;
    margin-bottom: 1.25rem;
    color: white;
  }

  .elite-card p {
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 2.5rem;
    flex-grow: 1;
    line-height: 1.8;
  }

  .text-cta {
    color: var(--brand-orange);
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1px;
  }

  .specialist-highlight {
    padding: 10rem 1rem;
  }

  .rounded-image {
    width: 100%;
    border-radius: 40px;
  }

  .badge {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    background: rgba(var(--brand-blue-rgb), 0.1);
    color: var(--brand-blue);
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  .actions-group {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
    .actions-group { flex-direction: column; }
  }
</style>
