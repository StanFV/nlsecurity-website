---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Demo — Mijn NL Security Portaal">

<div class="portal-wrap" data-app>

  <!-- ── Sidebar ── -->
  <aside class="sidebar">
    <div class="sb-top">
      <img src={`${base}/assets/images/logo.png`} alt="NL Security" class="sb-logo" />
      <div class="sb-client">
        <div class="sb-client-name">Gemeentehuis Den Haag</div>
        <div class="sb-contract">Contract #NLS-2024-0847</div>
      </div>
    </div>

    <nav class="sb-nav">
      <button class="sb-item active" data-tab="dashboard">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Dashboard
      </button>
      <button class="sb-item" data-tab="planning">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Planning & Bezetting
      </button>
      <button class="sb-item" data-tab="wijzigingen">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.13"/></svg>
        Wijzigingen
        <span class="sb-badge">1</span>
      </button>
      <button class="sb-item" data-tab="documenten">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Documenten
      </button>
      <button class="sb-item" data-tab="analyse">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Analyse & Rapportage
      </button>
      <button class="sb-item" data-tab="contact">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Contact
      </button>
    </nav>

    <div class="sb-bottom">
      <div class="sb-user">
        <div class="sb-avatar">AG</div>
        <div>
          <div class="sb-uname">A. de Groot</div>
          <div class="sb-urole">Portaalbeheerder</div>
        </div>
      </div>
      <a href={`${base}/mijn-nl-security`} class="back-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        Mijn NL Security sluiten
      </a>
      <div class="demo-tag">⚠ Concept demo — fictieve data</div>
    </div>
  </aside>

  <!-- ── Main ── -->
  <main class="portal-main">
    <div class="portal-topbar">
      <div class="topbar-left">
        <img src={`${base}/assets/images/logo zonder tekst.png`} alt="" class="topbar-logo-mobile" />
        <div>
          <h1 class="topbar-title" id="page-title">Dashboard</h1>
          <div class="topbar-bread">Mijn NL Security <span>›</span> <span id="bread-current">Dashboard</span></div>
        </div>
      </div>
      <div class="topbar-right">
        <div class="topbar-status">
          <span class="live-dot"></span> 3 van 3 locaties operationeel
        </div>
        <div class="topbar-date" id="live-date">9 mei 2025 — 09:41</div>
        <a href={`${base}/mijn-nl-security`} class="topbar-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          Mijn NL Security sluiten
        </a>
      </div>
    </div>

    <!-- ── Mobile Bottom Nav ── -->
    <nav class="bottom-nav">
      <button class="bnav-item active" data-tab="dashboard">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        <span>Dashboard</span>
      </button>
      <button class="bnav-item" data-tab="planning">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span>Planning</span>
      </button>
      <button class="bnav-item" data-tab="wijzigingen">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.13"/></svg>
        <span>Wijzigingen</span>
      </button>
      <button class="bnav-item" id="bnav-more-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
        <span>Meer</span>
      </button>
    </nav>

    <!-- ── Mobile More Menu ── -->
    <div class="more-menu-overlay" id="more-menu-overlay"></div>
    <div class="more-menu" id="more-menu">
      <div class="more-menu-header">
        <h4>Meer opties</h4>
        <button id="close-more-menu">✕</button>
      </div>
      <div class="more-menu-grid">
        <button class="more-item" data-tab="documenten">
          <div class="more-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg></div>
          <span>Documenten</span>
        </button>
        <button class="more-item" data-tab="analyse">
          <div class="more-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
          <span>Analyse</span>
        </button>
        <button class="more-item" data-tab="contact">
          <div class="more-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
          <span>Contact</span>
        </button>
      </div>
    </div>

    <!-- ── Demo notice ── -->
    <div class="demo-notice" id="demo-notice">
      <div class="demo-notice-inner">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span><strong>CONCEPT DEMO OMGEVING</strong> — Alle weergegeven gegevens zijn volledig fictief en dienen uitsluitend ter illustratie van het portaal. Dit is geen live klantomgeving.</span>
        <button class="demo-dismiss" id="demo-dismiss">✕ Sluiten</button>
      </div>
    </div>

    <!-- ── DASHBOARD ── -->
    <section id="tab-dashboard" class="tab-content">
      <div class="kpi-row">
        <div class="kpi-card">
          <div class="kpi-icon blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          </div>
          <div>
            <div class="kpi-val" data-count="3">0</div>
            <div class="kpi-label">Actieve Locaties</div>
            <div class="kpi-sub">Amsterdam · Rotterdam · Utrecht</div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon orange">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div>
            <div class="kpi-val" data-count="7">0</div>
            <div class="kpi-label">Ingezette Beveiligers</div>
            <div class="kpi-sub">Deze week door NL Security</div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <div class="kpi-val" data-count="1248" data-suffix="">0</div>
            <div class="kpi-label">Contracturen April</div>
            <div class="kpi-sub">Van 1.260 geplande uren</div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon orange">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <div>
            <div class="kpi-val"><span data-count-dec="94.3">0</span><small>%</small></div>
            <div class="kpi-label">Bezettingsgraad</div>
            <div class="kpi-sub">Afgelopen 30 dagen</div>
          </div>
        </div>
      </div>

      <div class="dash-row">
        <div class="card">
          <div class="card-head">
            <h3>Ingezette uren — Afgelopen 7 dagen</h3>
            <span class="live-badge"><span class="live-dot sm"></span> Live</span>
          </div>
          <div class="chart-wrap">
            <div class="bar-chart" id="dash-chart">
              <div class="bar-col"><div class="bar" data-base="72"></div><span>ma</span></div>
              <div class="bar-col"><div class="bar" data-base="88"></div><span>di</span></div>
              <div class="bar-col"><div class="bar accent" data-base="95"></div><span>wo</span></div>
              <div class="bar-col"><div class="bar" data-base="80"></div><span>do</span></div>
              <div class="bar-col"><div class="bar" data-base="85"></div><span>vr</span></div>
              <div class="bar-col"><div class="bar" data-base="55"></div><span>za</span></div>
              <div class="bar-col"><div class="bar" data-base="30"></div><span>zo</span></div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head"><h3>Locaties & Bezetting</h3></div>
          <div class="loc-list">
            <div class="loc-item">
              <div class="loc-dot-wrap"><div class="loc-dot green"></div></div>
              <div class="loc-info">
                <strong>Amsterdam HQ</strong>
                <span>Herengracht 450</span>
              </div>
              <div class="loc-right">
                <div class="bezetting-bar"><div class="bezetting-fill" style="width:100%"></div></div>
                <span class="loc-count">4 / 4</span>
              </div>
            </div>
            <div class="loc-item">
              <div class="loc-dot-wrap"><div class="loc-dot green"></div></div>
              <div class="loc-info">
                <strong>Rotterdam Depot</strong>
                <span>Waalhaven 12</span>
              </div>
              <div class="loc-right">
                <div class="bezetting-bar"><div class="bezetting-fill" style="width:100%"></div></div>
                <span class="loc-count">2 / 2</span>
              </div>
            </div>
            <div class="loc-item">
              <div class="loc-dot-wrap"><div class="loc-dot orange"></div></div>
              <div class="loc-info">
                <strong>Utrecht Kantoor</strong>
                <span>Stadsplateau 1 — week 19 tijdelijk onderbezet</span>
              </div>
              <div class="loc-right">
                <div class="bezetting-bar"><div class="bezetting-fill orange" style="width:0%"></div></div>
                <span class="loc-count orange">0 / 1</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="dash-row-bottom">
        <div class="card">
          <div class="card-head">
            <h3>Live Activiteitenfeed</h3>
            <span class="live-badge"><span class="live-dot sm"></span> Live</span>
          </div>
          <div class="activity-feed" id="activity-feed">
            <div class="activity-item">
              <span class="act-dot green"></span>
              <span class="act-time">09:41</span>
              <span class="act-text">J. de Vries — dienst gestart (Amsterdam HQ)</span>
            </div>
            <div class="activity-item">
              <span class="act-dot blue"></span>
              <span class="act-time">09:15</span>
              <span class="act-text">Dagrapport ontvangen — Amsterdam HQ</span>
            </div>
            <div class="activity-item">
              <span class="act-dot orange"></span>
              <span class="act-time">08:52</span>
              <span class="act-text">Wijzigingsverzoek ingediend — Utrecht (vervanging L. Hendriks)</span>
            </div>
            <div class="activity-item">
              <span class="act-dot blue"></span>
              <span class="act-time">08:00</span>
              <span class="act-text">M. Santos — dienst gestart (Rotterdam Depot)</span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <h3>Dagrapportages</h3>
            <button class="btn-sm">Alle rapportages →</button>
          </div>
        <div class="table-scroll">
          <table class="dtable">
            <thead><tr><th>Datum</th><th>Locatie</th><th>Onderwerp</th><th>Status</th></tr></thead>
            <tbody>
              <tr>
                <td>09 mei 2025 — 08:00</td>
                <td>Amsterdam HQ</td>
                <td>W19 dagrapport maandag — reguliere dienst, geen bijzonderheden</td>
                <td><span class="badge green">Ontvangen</span></td>
              </tr>
              <tr>
                <td>08 mei 2025 — 22:15</td>
                <td>Rotterdam Depot</td>
                <td>Overdrachtsrapport avonddienst — sleuteloverdracht geregistreerd</td>
                <td><span class="badge green">Ontvangen</span></td>
              </tr>
              <tr>
                <td>07 mei 2025 — 14:00</td>
                <td>Amsterdam HQ</td>
                <td>Instructiewijziging toegangsbeleid receptie — update verwerkt</td>
                <td><span class="badge grey">Verwerkt</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        </div>
      </div>
    </section>

    <!-- ── PLANNING ── -->
    <section id="tab-planning" class="tab-content hidden">
      <div class="card">
        <div class="card-head">
          <h3>Roostering — Week 19 (5 t/m 11 mei 2025)</h3>
          <div class="btn-group">
            <button class="btn-sm">← Vorige week</button>
            <button class="btn-sm">Volgende week →</button>
          </div>
        </div>
        <div class="nl-security-note">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Onderstaande medewerkers zijn in dienst van NL Security en worden ingezet op uw locaties.
        </div>
        <div class="table-scroll">
          <table class="dtable planning">
            <thead>
              <tr>
                <th>Medewerker</th><th>Functie</th><th>Locatie</th>
                <th>Ma</th><th>Di</th><th>Wo</th><th>Do</th><th>Vr</th><th>Za</th><th>Zo</th>
                <th>Kwalificaties</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><div class="guard"><div class="gav blue">JV</div>J. de Vries</div></td>
                <td><span class="role-badge sr">Sr. Beveiliger</span></td>
                <td>Amsterdam HQ</td>
                <td><span class="shift d">06–14</span></td><td><span class="shift d">06–14</span></td>
                <td><span class="shift d">06–14</span></td><td><span class="shift d">06–14</span></td>
                <td><span class="shift d">06–14</span></td>
                <td class="off">—</td><td class="off">—</td>
                <td><span class="cert">BHV</span><span class="cert">EHBO</span></td>
              </tr>
              <tr>
                <td><div class="guard"><div class="gav orange">FE</div>F. el Amrani</div></td>
                <td><span class="role-badge">Beveiliger</span></td>
                <td>Amsterdam HQ</td>
                <td><span class="shift m">14–22</span></td><td><span class="shift m">14–22</span></td>
                <td><span class="shift m">14–22</span></td><td><span class="shift m">14–22</span></td>
                <td><span class="shift m">14–22</span></td>
                <td class="off">—</td><td class="off">—</td>
                <td><span class="cert">BHV</span></td>
              </tr>
              <tr>
                <td><div class="guard"><div class="gav blue">SB</div>S. Bakker</div></td>
                <td><span class="role-badge">Beveiliger</span></td>
                <td>Amsterdam HQ</td>
                <td class="off">—</td><td class="off">—</td><td class="off">—</td><td class="off">—</td><td class="off">—</td>
                <td><span class="shift d">06–18</span></td><td><span class="shift d">06–18</span></td>
                <td>—</td>
              </tr>
              <tr>
                <td><div class="guard"><div class="gav blue">RK</div>R. Krishnan</div></td>
                <td><span class="role-badge sr">Sr. Beveiliger</span></td>
                <td>Amsterdam HQ</td>
                <td><span class="shift n">22–06</span></td><td><span class="shift n">22–06</span></td>
                <td><span class="shift n">22–06</span></td><td><span class="shift n">22–06</span></td>
                <td><span class="shift n">22–06</span></td>
                <td class="off">—</td><td class="off">—</td>
                <td><span class="cert">BHV</span></td>
              </tr>
              <tr>
                <td><div class="guard"><div class="gav orange">MS</div>M. Santos</div></td>
                <td><span class="role-badge">Beveiliger</span></td>
                <td>Rotterdam Depot</td>
                <td><span class="shift d">08–16</span></td><td><span class="shift d">08–16</span></td>
                <td><span class="shift d">08–16</span></td><td><span class="shift d">08–16</span></td>
                <td><span class="shift d">08–16</span></td>
                <td><span class="shift d">08–16</span></td><td class="off">—</td>
                <td><span class="cert">BHV</span></td>
              </tr>
              <tr>
                <td><div class="guard"><div class="gav blue">KP</div>K. Prins</div></td>
                <td><span class="role-badge">Beveiliger</span></td>
                <td>Rotterdam Depot</td>
                <td><span class="shift m">16–00</span></td><td><span class="shift m">16–00</span></td>
                <td><span class="shift m">16–00</span></td><td><span class="shift m">16–00</span></td>
                <td><span class="shift m">16–00</span></td>
                <td><span class="shift m">16–00</span></td><td><span class="shift m">16–00</span></td>
                <td>—</td>
              </tr>
              <tr class="sick-row">
                <td><div class="guard"><div class="gav grey">LH</div>L. Hendriks</div></td>
                <td><span class="role-badge">Beveiliger</span></td>
                <td>Utrecht Kantoor</td>
                <td colspan="7" class="sick-cell">Afwezig week 19 — vervanging aangevraagd bij NL Security planning</td>
                <td><span class="cert">BHV</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ── WIJZIGINGEN ── -->
    <section id="tab-wijzigingen" class="tab-content hidden">
      <div class="two-col">
        <div class="card">
          <div class="card-head"><h3>Nieuw Verzoek Indienen</h3></div>
          <form class="pform">
            <div class="fg">
              <label>Type verzoek</label>
              <select>
                <option>Extra inzet aanvragen</option>
                <option>Instructies wijzigen</option>
                <option>Vervanging aanvragen</option>
                <option>Roosterwijziging</option>
                <option>Overige</option>
              </select>
            </div>
            <div class="fg">
              <label>Locatie</label>
              <select>
                <option>Amsterdam HQ — Herengracht 450</option>
                <option>Rotterdam Depot — Waalhaven 12</option>
                <option>Utrecht Kantoor — Stadsplateau 1</option>
              </select>
            </div>
            <div class="fg">
              <label>Datum / Periode</label>
              <input type="date" value="2025-05-12" />
            </div>
            <div class="fg">
              <label>Omschrijving</label>
              <textarea rows="4" placeholder="Beschrijf uw verzoek. Onze planners nemen zo snel mogelijk contact op."></textarea>
            </div>
            <div class="fg">
              <label>Urgentie</label>
              <div class="radio-row">
                <label><input type="radio" name="urg" /> Laag</label>
                <label><input type="radio" name="urg" checked /> Normaal</label>
                <label><input type="radio" name="urg" /> Hoog</label>
              </div>
            </div>
            <button type="button" class="btn-primary" id="submit-btn">Verzoek Indienen</button>
            <div id="success-msg" class="success-msg hidden">✓ Verzoek ontvangen — onze planners nemen contact op (ma–vr 07:00–17:00)</div>
          </form>
        </div>
        <div class="card">
          <div class="card-head"><h3>Recente Verzoeken</h3></div>
          <div class="req-list">
            <div class="req-item">
              <div class="req-info">
                <strong>Extra inzet — Koningsdag</strong>
                <span>Amsterdam HQ · 27 apr 2025</span>
              </div>
