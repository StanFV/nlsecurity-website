<script>
  // Skip global animations on this app page
  document.documentElement.dataset.app = '1';

  const tabTitles: Record<string, string> = {
    dashboard: 'Dashboard',
    planning: 'Planning & Bezetting',
    wijzigingen: 'Wijzigingen Doorgeven',
    documenten: 'Documentenbeheer',
    analyse: 'Analyse & Rapportage',
    contact: 'Direct Contact',
  };

  document.querySelectorAll('.sb-item').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = (btn as HTMLElement).dataset.tab!;
      document.querySelectorAll('.tab-content').forEach(p => p.classList.add('hidden'));
      document.querySelectorAll('.sb-item').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-' + tab)?.classList.remove('hidden');
      btn.classList.add('active');
      (document.getElementById('page-title') as HTMLElement).textContent = tabTitles[tab];
      (document.getElementById('bread-current') as HTMLElement).textContent = tabTitles[tab];
    });
  });

  // Submit demo
  document.getElementById('submit-btn')?.addEventListener('click', () => {
    document.getElementById('success-msg')?.classList.remove('hidden');
    setTimeout(() => document.getElementById('success-msg')?.classList.add('hidden'), 4000);
  });

  // Animated bars
  function animateBars(chartId: string) {
    const bars = document.querySelectorAll<HTMLElement>(`#${chartId} .bar`);
    bars.forEach(bar => {
      const base = parseInt(bar.dataset.base || '50');
      bar.style.height = base + '%';
      function pulse() {
        const jitter = (Math.random() - 0.5) * 22;
        bar.style.height = Math.max(5, Math.min(95, base + jitter)) + '%';
        setTimeout(pulse, 1800 + Math.random() * 2400);
      }
      setTimeout(pulse, Math.random() * 1500);
    });
  }

  animateBars('dash-chart');
  animateBars('analyse-chart');
</script>

