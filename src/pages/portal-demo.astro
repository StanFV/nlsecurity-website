<script>
  document.documentElement.dataset.app = '1';

  const tabTitles: Record<string, string> = {
    dashboard: 'Dashboard',
    planning: 'Planning & Bezetting',
    wijzigingen: 'Wijzigingen Doorgeven',
    documenten: 'Documentenbeheer',
    analyse: 'Analyse & Rapportage',
    contact: 'Contact',
  };

  // Card entrance animations on tab switch
  function animateTabIn(tabId: string) {
    const tab = document.getElementById('tab-' + tabId);
    if (!tab) return;
    const cards = tab.querySelectorAll<HTMLElement>('.card, .kpi-card, .contact-card');
    cards.forEach((card, i) => {
      card.classList.remove('card-in');
      card.style.animationDelay = `${i * 0.07}s`;
      void card.offsetWidth; // reflow
      card.classList.add('card-in');
    });
    // Stagger table rows
    tab.querySelectorAll<HTMLElement>('.dtable tbody tr').forEach((row, i) => {
      row.style.opacity = '0';
      row.style.transform = 'translateX(-10px)';
      row.style.transition = 'none';
      setTimeout(() => {
        row.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
        row.style.opacity = '1';
        row.style.transform = '';
      }, 120 + i * 55);
    });
    // Stagger req-list items
    tab.querySelectorAll<HTMLElement>('.req-item').forEach((item, i) => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(10px)';
      item.style.transition = 'none';
      setTimeout(() => {
        item.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
        item.style.opacity = '1';
        item.style.transform = '';
      }, 80 + i * 60);
    });
  }

  function switchTab(tab: string, sourceBtn?: Element) {
    document.querySelectorAll('.tab-content').forEach(p => p.classList.add('hidden'));
    document.querySelectorAll('.sb-item').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.bnav-item').forEach(b => b.classList.remove('active'));
    
    document.getElementById('tab-' + tab)?.classList.remove('hidden');
    
    // Mark sidebar btn active
    document.querySelectorAll<HTMLElement>('.sb-item').forEach(b => { if (b.dataset.tab === tab) b.classList.add('active'); });
    // Mark bottom nav btn active
    document.querySelectorAll<HTMLElement>('.bnav-item').forEach(b => { if (b.dataset.tab === tab) b.classList.add('active'); });

    (document.getElementById('page-title') as HTMLElement).textContent = tabTitles[tab];
    (document.getElementById('bread-current') as HTMLElement).textContent = tabTitles[tab];
    
    animateTabIn(tab);
    if (tab === 'analyse') animateStatBars();
    if (tab === 'wijzigingen') {
      const badge = document.querySelector<HTMLElement>('.sb-badge');
      if (badge) { badge.style.transform = 'scale(0)'; badge.style.opacity = '0'; }
    }

    // Close more menu if an item was clicked
    if (sourceBtn?.classList.contains('more-item')) {
      closeMoreMenu();
    }
  }

  document.querySelectorAll('.sb-item').forEach(btn => {
    btn.addEventListener('click', () => switchTab((btn as HTMLElement).dataset.tab!));
  });

  document.querySelectorAll('.bnav-item[data-tab]').forEach(btn => {
    btn.addEventListener('click', () => switchTab((btn as HTMLElement).dataset.tab!));
  });

  document.querySelectorAll('.more-item').forEach(btn => {
    btn.addEventListener('click', () => switchTab((btn as HTMLElement).dataset.tab!, btn));
  });

  // More Menu Logic
  const moreBtn = document.getElementById('bnav-more-btn');
  const moreMenu = document.getElementById('more-menu');
  const moreOverlay = document.getElementById('more-menu-overlay');
  const closeMore = document.getElementById('close-more-menu');

  function openMoreMenu() {
    moreMenu?.classList.add('active');
    moreOverlay?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMoreMenu() {
    moreMenu?.classList.remove('active');
    moreOverlay?.classList.remove('active');
    document.body.style.overflow = 'auto';
  }

  moreBtn?.addEventListener('click', openMoreMenu);
  moreOverlay?.addEventListener('click', closeMoreMenu);
  closeMore?.addEventListener('click', closeMoreMenu);

  // Initial animation on dashboard
  setTimeout(() => animateTabIn('dashboard'), 100);

  // Demo notice dismiss
  document.getElementById('demo-dismiss')?.addEventListener('click', () => {
    const notice = document.getElementById('demo-notice');
    if (notice) { notice.style.transition = 'opacity 0.3s, transform 0.3s'; notice.style.opacity = '0'; notice.style.transform = 'translateY(-8px)'; setTimeout(() => notice.style.display = 'none', 300); }
  });

  // Submit demo
  document.getElementById('submit-btn')?.addEventListener('click', () => {
    const msg = document.getElementById('success-msg');
    msg?.classList.remove('hidden');
    setTimeout(() => msg?.classList.add('hidden'), 5000);
  });

  // KPI count-up
  function countUp(el: HTMLElement, target: number, duration = 900, decimals = 0) {
    const start = performance.now();
    const suffix = el.dataset.suffix ?? '';
    function step(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const ease = 1 - Math.pow(1 - progress, 3);
      const val = ease * target;
      el.textContent = (decimals > 0 ? val.toFixed(decimals) : Math.round(val).toLocaleString('nl-NL')) + suffix;
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  document.querySelectorAll<HTMLElement>('[data-count]').forEach(el => {
    const target = parseFloat(el.dataset.count!);
    setTimeout(() => countUp(el, target, 1000), 300);
  });
  document.querySelectorAll<HTMLElement>('[data-count-dec]').forEach(el => {
    const target = parseFloat(el.dataset.countDec!);
    setTimeout(() => countUp(el, target, 1100, 1), 300);
  });

  // Animated bar charts — visible jitter
  function animateBars(chartId: string) {
    const bars = document.querySelectorAll<HTMLElement>(`#${chartId} .bar`);
    bars.forEach(bar => {
      const base = parseInt(bar.dataset.base || '50');
      bar.style.height = base + '%';
      function pulse() {
        const jitter = (Math.random() - 0.5) * 40;
        bar.style.height = Math.max(8, Math.min(98, base + jitter)) + '%';
        setTimeout(pulse, 800 + Math.random() * 1000);
      }
      setTimeout(pulse, Math.random() * 500);
    });
  }
  animateBars('dash-chart');
  animateBars('analyse-chart');

  // Bezetting bar animate on load
  document.querySelectorAll<HTMLElement>('.bezetting-fill').forEach(el => {
    const width = el.style.width;
    el.style.width = '0%';
    setTimeout(() => { el.style.transition = 'width 1.4s cubic-bezier(0.16,1,0.3,1)'; el.style.width = width; }, 500);
  });

  // Stat bars animate when analyse tab opens
  function animateStatBars() {
    document.querySelectorAll<HTMLElement>('.stat-fill').forEach(el => {
      const pct = el.dataset.pct || '0';
      el.style.width = '0%';
      setTimeout(() => { el.style.width = pct + '%'; }, 100);
    });
  }

  // Live clock
  function updateClock() {
    const now = new Date();
    const d = now.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
    const t = now.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' });
    const el = document.getElementById('live-date');
    if (el) el.textContent = `${d} — ${t}`;
  }
  updateClock();
  setInterval(updateClock, 30000);

  // ── Continuous live animations ──

  // KPI numbers fluctuate
  function bumpEl(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove('kpi-bump');
    void el.offsetWidth;
    el.classList.add('kpi-bump');
  }

  function startLiveKPIs() {
    let hours = 1248;
    const hoursEl = document.querySelector<HTMLElement>('[data-count="1248"]');
    setInterval(() => {
      hours += Math.floor(Math.random() * 3) + 1;
      if (hoursEl) { hoursEl.textContent = hours.toLocaleString('nl-NL'); bumpEl(hoursEl); }
    }, 2200);

    const bezEl = document.querySelector<HTMLElement>('[data-count-dec="94.3"]');
    setInterval(() => {
      const val = 92.5 + Math.random() * 3.5;
      if (bezEl) { bezEl.textContent = val.toFixed(1); bumpEl(bezEl); }
    }, 3000);

    // Guards count fluctuates
    const guardsEl = document.querySelector<HTMLElement>('[data-count="7"]');
    setInterval(() => {
      const val = Math.random() > 0.3 ? 7 : 6;
      if (guardsEl) { guardsEl.textContent = String(val); bumpEl(guardsEl); }
    }, 7000);

    // Topbar status updates more visibly
    const statusEl = document.querySelector<HTMLElement>('.topbar-status');
    const statusTexts = [
      '<span class="live-dot"></span> Bezetting wordt bijgewerkt…',
      '<span class="live-dot"></span> 2 van 3 locaties volledig bezet',
      '<span class="live-dot"></span> 3 van 3 locaties operationeel',
    ];
    let statusIdx = 0;
    setInterval(() => {
      if (!statusEl) return;
      statusIdx = (statusIdx + 1) % statusTexts.length;
      statusEl.style.opacity = '0.4';
      setTimeout(() => {
        statusEl.innerHTML = statusTexts[statusIdx];
        statusEl.style.opacity = '1';
        statusEl.style.transition = 'opacity 0.4s';
      }, 400);
    }, 8000);
  }
  startLiveKPIs();

  // Planning tab: presence dots + row flashes
  function startPlanningLive() {
    // Add pulsing green dot to active guard rows
    document.querySelectorAll<HTMLElement>('#tab-planning .dtable tbody tr').forEach(row => {
      const guardDiv = row.querySelector<HTMLElement>('.guard');
      if (!guardDiv || guardDiv.querySelector('.presence-dot')) return;
      const dot = document.createElement('span');
      dot.className = 'presence-dot' + (row.classList.contains('sick-row') ? ' away' : '');
      guardDiv.insertBefore(dot, guardDiv.firstChild);
    });

    // Flash random active planning rows
    const activeRows = Array.from(document.querySelectorAll<HTMLElement>('#tab-planning .dtable tbody tr:not(.sick-row)'));
    setInterval(() => {
      const row = activeRows[Math.floor(Math.random() * activeRows.length)];
      row.classList.remove('row-flash');
      void row.offsetWidth;
      row.classList.add('row-flash');
    }, 2500);
  }
  // Call once so dots are ready even before tab opens
  startPlanningLive();
  // Re-run when planning tab opens to ensure dots persist after card animation
  document.querySelectorAll('.sb-item, .mobile-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if ((btn as HTMLElement).dataset.tab === 'planning') {
        setTimeout(startPlanningLive, 300);
      }
    });
  });

  // Dagrapportages: flash rows as if new data received
  function startDagrapportLive() {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#tab-dashboard .dtable tbody tr'));
    setInterval(() => {
      const row = rows[Math.floor(Math.random() * rows.length)];
      row.classList.remove('row-flash-green');
      void row.offsetWidth;
      row.classList.add('row-flash-green');
    }, 3500);
  }
  startDagrapportLive();

  // Bezetting bars: visible oscillation
  function startBezettingLive() {
    document.querySelectorAll<HTMLElement>('.bezetting-fill:not(.orange)').forEach(fill => {
      function breathe() {
        const val = 70 + Math.random() * 30;
        fill.style.transition = 'width 1.2s cubic-bezier(0.16,1,0.3,1)';
        fill.style.width = val + '%';
        setTimeout(breathe, 1400 + Math.random() * 1200);
      }
      setTimeout(breathe, Math.random() * 600);
    });
  }
  startBezettingLive();

  // Analyse stat bars: re-pulse every 10s
  setInterval(() => {
    if (!document.getElementById('tab-analyse')?.classList.contains('hidden')) {
      animateStatBars();
    }
  }, 10000);

  // ── Welcome tour ──
  const tourSteps = [
    {
      title: 'Welkom bij de demo',
      text: 'Dit is een interactieve demo van het Mijn NL Security portaal. Alle data is fictief. U kunt overal op klikken — volledig vrijblijvend.',
      target: null,
    },
    {
      title: 'Navigeer tussen modules',
      text: 'Via de zijbalk schakelt u tussen Dashboard, Planning, Wijzigingen, Documenten, Analyse en Contact.',
      target: '.sb-nav',
    },
    {
      title: 'Live dashboard',
      text: 'Het dashboard toont actuele KPI\'s, bezettingsgraad per locatie en een live activiteitenfeed.',
      target: '.kpi-row',
    },
    {
      title: 'Terug naar de website',
      text: 'Via deze knop keert u terug naar de Mijn NL Security pagina. Ook bovenin het scherm vindt u een "Terug"-knop.',
      target: '.back-btn',
    },
    {
      title: 'Klaar om te verkennen',
      text: 'Dat was de korte rondleiding. Klik op de tabbladen om alle functionaliteiten zelf te ontdekken.',
      target: null,
      isLast: true,
    },
  ];

  let tourStep = 0;

  const tourOverlay = document.getElementById('tour-overlay')!;
  const tourRing = document.getElementById('tour-ring')!;
  const tourCard = document.getElementById('tour-card')!;
  const tourTitle = document.getElementById('tour-title')!;
  const tourDesc = document.getElementById('tour-desc')!;
  const tourDotsEl = document.getElementById('tour-dots')!;
  const tourStepLabel = document.getElementById('tour-step-label')!;
  const tourNextBtn = document.getElementById('tour-next-btn') as HTMLButtonElement;
  const tourPrevBtn = document.getElementById('tour-prev-btn') as HTMLButtonElement;

  function showTourStep(idx: number) {
    const step = tourSteps[idx];
    tourStepLabel.textContent = `Stap ${idx + 1} van ${tourSteps.length}`;
    tourTitle.textContent = step.title;
    tourDesc.textContent = step.text;
    tourPrevBtn.disabled = idx === 0;
    tourNextBtn.textContent = step.isLast ? 'Starten ✓' : 'Volgende →';

    // Dots
    tourDotsEl.innerHTML = '';
    tourSteps.forEach((_, i) => {
      const d = document.createElement('div');
      d.className = 'tour-dot' + (i === idx ? ' active' : '');
      tourDotsEl.appendChild(d);
    });

    // Spotlight ring — use mobile-friendly targets on small screens
    const isMobile = window.innerWidth <= 768;
    let target = step.target;
    if (isMobile) {
      if (target === '.sb-nav') target = '.bottom-nav';
      if (target === '.back-btn') target = '.topbar-back';
    }
    if (target) {
      const el = document.querySelector<HTMLElement>(target);
      if (el) {
        const r = el.getBoundingClientRect();
        const pad = 10;
        (tourRing as HTMLElement).style.top = (r.top - pad) + 'px';
        (tourRing as HTMLElement).style.left = (r.left - pad) + 'px';
        (tourRing as HTMLElement).style.width = (r.width + pad * 2) + 'px';
        (tourRing as HTMLElement).style.height = (r.height + pad * 2) + 'px';
        tourRing.classList.add('active');
      } else {
        tourRing.classList.remove('active');
      }
    } else {
      tourRing.classList.remove('active');
    }
  }

  function endTour() {
    tourOverlay.classList.remove('active');
    tourCard.classList.remove('active');
    tourRing.classList.remove('active');
  }

  function startTour() {
    tourStep = 0;
    tourOverlay.classList.add('active');
    tourCard.classList.add('active');
    showTourStep(0);
  }

  tourNextBtn.addEventListener('click', () => {
    if (tourStep >= tourSteps.length - 1) { endTour(); return; }
    tourStep++;
    showTourStep(tourStep);
  });
  tourPrevBtn.addEventListener('click', () => {
    if (tourStep <= 0) return;
    tourStep--;
    showTourStep(tourStep);
  });
  document.getElementById('tour-skip-btn')?.addEventListener('click', endTour);

  // Start tour after a short delay
  setTimeout(startTour, 900);

  // ── Live activity feed — new items appear periodically
  const liveEvents = [
    { dot: 'green', text: 'R. Krishnan — overdracht afgerond (Amsterdam HQ)' },
    { dot: 'blue', text: 'Dagrapport bevestigd — Rotterdam Depot' },
    { dot: 'orange', text: 'Planning update — week 20 concept beschikbaar' },
    { dot: 'green', text: 'K. Prins — dienst gestart (Rotterdam Depot)' },
    { dot: 'blue', text: 'Factuur mei 2025 klaargezet in Documenten' },
  ];
  let eventIdx = 0;
  function addFeedItem() {
    const feed = document.getElementById('activity-feed');
    if (!feed) return;
    const ev = liveEvents[eventIdx % liveEvents.length];
    eventIdx++;
    const now = new Date();
    const time = now.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' });
    const item = document.createElement('div');
    item.className = 'activity-item act-new';
    item.innerHTML = `<span class="act-dot ${ev.dot}"></span><span class="act-time">${time}</span><span class="act-text">${ev.text}</span>`;
    feed.insertBefore(item, feed.firstChild);
    // Remove oldest if more than 5
    while (feed.children.length > 5) feed.removeChild(feed.lastChild!);
    // Schedule next
    setTimeout(addFeedItem, 6000 + Math.random() * 8000);
  }
  setTimeout(addFeedItem, 7000);
</script>

</BaseLayout>
