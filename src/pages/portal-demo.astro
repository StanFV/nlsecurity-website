  .req-info strong { display: block; font-size: 0.87rem; color: #1e293b; }
  .req-info span { font-size: 0.75rem; color: #94a3b8; }

  /* ── Documenten ── */
  .doc-name { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: #1e293b; }

  /* ── Analyse stats ── */
  .stat-rows { padding: 0.25rem 0; }
  .stat-row { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.5rem; border-bottom: 1px solid #f1f5f9; font-size: 0.85rem; gap: 1rem; }
  .stat-row:last-child { border-bottom: none; }
  .stat-row > span { color: #64748b; flex-shrink: 0; }
  .stat-right { display: flex; align-items: center; gap: 0.75rem; }
  .stat-right strong { color: #1e293b; font-weight: 800; white-space: nowrap; }
  .stat-right strong.good { color: #16a34a; }
  .stat-bar { width: 80px; height: 5px; background: #e8ecf2; border-radius: 3px; overflow: hidden; flex-shrink: 0; }
  .stat-fill { height: 100%; background: rgba(var(--brand-blue-rgb),0.6); border-radius: 3px; width: 0%; transition: width 1.6s cubic-bezier(0.16,1,0.3,1); }
  .stat-fill.good { background: #22c55e; }
  .report-text { padding: 1.5rem; }
  .report-text p { color: #475569; line-height: 1.7; margin-bottom: 1rem; font-size: 0.88rem; }
  .report-text p:last-child { margin-bottom: 0; }

  /* ── Contact ── */
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
  .contact-card { padding: 2rem 1.5rem; text-align: center; }
  .contact-card h3 { font-size: 1.05rem; margin: 0.75rem 0 0.2rem; color: var(--brand-blue); }
  .contact-role { color: #94a3b8; font-size: 0.78rem; margin-bottom: 1rem; }
  .contact-av { width: 60px; height: 60px; border-radius: 50%; margin: 0 auto; font-size: 0.72rem; font-weight: 900; display: flex; align-items: center; justify-content: center; }
  .contact-av.blue { background: rgba(var(--brand-blue-rgb),0.12); color: var(--brand-blue); }
  .contact-av.orange { background: rgba(255,102,0,0.12); color: var(--brand-orange); }
  .contact-rows { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem; font-size: 0.82rem; color: #475569; }
  .contact-rows a { color: var(--brand-blue); text-decoration: none; font-weight: 600; }
  .contact-note { font-size: 0.78rem; color: #94a3b8; line-height: 1.5; margin-bottom: 1.25rem; }

  /* ── Buttons ── */
  .btn-sm { padding: 0.38rem 0.85rem; border: 1.5px solid #e2e8f0; border-radius: 6px; background: white; font-size: 0.75rem; font-weight: 700; color: #475569; cursor: pointer; transition: 0.2s; font-family: inherit; }
  .btn-sm:hover { border-color: var(--brand-blue); color: var(--brand-blue); }
  .btn-group { display: flex; gap: 0.5rem; }
  .btn-primary { padding: 0.7rem 1.5rem; background: var(--brand-blue); color: white; border: none; border-radius: 8px; font-weight: 700; font-size: 0.88rem; cursor: pointer; transition: 0.2s; width: 100%; font-family: inherit; }
  .btn-primary:hover { background: var(--brand-orange); }
  .btn-primary-sm { padding: 0.38rem 0.85rem; background: var(--brand-blue); color: white; border: none; border-radius: 6px; font-size: 0.75rem; font-weight: 700; cursor: pointer; transition: 0.2s; font-family: inherit; }
