---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Demo — Mijn NL Security Portaal">

<div class="demo-notice">
  <span class="demo-badge">DEMO</span>
  Demonstratie omgeving — alle gegevens zijn fictief en dienen uitsluitend ter illustratie
  <a href={`${base}/mijn-nl-security`} class="demo-back">← Terug naar informatiepagina</a>
</div>

<div class="portal-wrap" data-app>
  <aside class="sidebar">
    <div class="sb-top">
      <img src={`${base}/assets/images/logo.png`} alt="NL Security" class="sb-logo" />
      <div class="sb-client">
        <div class="sb-client-name">Pensioenfonds Horeca</div>
        <div class="sb-contract">Contract #NLS-2024-0847</div>
      </div>
    </div>

    <nav class="sb-nav">
      <button class="sb-item active" data-tab="dashboard">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Dashboard
      </button>
      <button class="sb-item" data-tab="planning">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Planning & Bezetting
      </button>
      <button class="sb-item" data-tab="wijzigingen">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.13"/></svg>
        Wijzigingen
      </button>
      <button class="sb-item" data-tab="documenten">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Documenten
      </button>
      <button class="sb-item" data-tab="analyse">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Analyse & Rapportage
      </button>
      <button class="sb-item" data-tab="contact">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 11.69 19a19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Direct Contact
      </button>
    </nav>

    <div class="sb-user">
      <div class="sb-avatar">AG</div>
      <div>
        <div class="sb-uname">A. de Groot</div>
        <div class="sb-urole">Portaalbeheerder</div>
      </div>
    </div>
  </aside>

  <main class="portal-main">
    <div class="portal-topbar">
      <div>
        <h1 class="topbar-title" id="page-title">Dashboard</h1>
        <div class="topbar-bread">Mijn NL Security <span>›</span> <span id="bread-current">Dashboard</span></div>
      </div>
      <div class="topbar-right">
        <div class="topbar-status"><span class="sdot green"></span> 2 van 3 locaties veilig</div>
        <div class="topbar-date">08 mei 2025 — 14:32</div>
      </div>
    </div>

    <!-- ── DASHBOARD ── -->
    <section id="tab-dashboard" class="tab-content">
      <div class="kpi-row">
        <div class="kpi-card">
          <div class="kpi-icon blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          </div>
          <div>
            <div class="kpi-val">3</div>
            <div class="kpi-label">Actieve Locaties</div>
            <div class="kpi-sub">Amsterdam · Rotterdam · Utrecht</div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon orange">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div>
            <div class="kpi-val">6</div>
            <div class="kpi-label">Beveiligers Vandaag</div>
            <div class="kpi-sub warn">⚠ 1 positie open — Utrecht</div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          </div>
          <div>
            <div class="kpi-val">2</div>
            <div class="kpi-label">Incidenten Deze Maand</div>
            <div class="kpi-sub good">↓ 33% t.o.v. vorige maand</div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon orange">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <div>
            <div class="kpi-val">96.4<small>%</small></div>
            <div class="kpi-label">Bezettingsgraad</div>
            <div class="kpi-sub">Afgelopen 30 dagen</div>
          </div>
        </div>
      </div>

      <div class="dash-row">
        <div class="card">
          <div class="card-head"><h3>Incidenten — Afgelopen 7 Dagen</h3></div>
          <div class="chart-wrap">
            <div class="bar-chart" id="dash-chart">
              <div class="bar-col"><div class="bar" data-base="25"></div><span>ma</span></div>
              <div class="bar-col"><div class="bar" data-base="55"></div><span>di</span></div>
              <div class="bar-col"><div class="bar accent" data-base="80"></div><span>wo</span></div>
              <div class="bar-col"><div class="bar" data-base="35"></div><span>do</span></div>
              <div class="bar-col"><div class="bar" data-base="65"></div><span>vr</span></div>
              <div class="bar-col"><div class="bar" data-base="45"></div><span>za</span></div>
              <div class="bar-col"><div class="bar" data-base="20"></div><span>zo</span></div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head"><h3>Locatiestatus</h3></div>
          <div class="loc-list">
            <div class="loc-item">
              <div class="loc-dot green"></div>
              <div class="loc-info">
                <strong>Amsterdam HQ</strong>
                <span>Herengracht 450 — 4 beveiligers actief</span>
              </div>
              <span class="badge green">Veilig</span>
            </div>
            <div class="loc-item">
              <div class="loc-dot green"></div>
              <div class="loc-info">
                <strong>Rotterdam Depot</strong>
                <span>Waalhaven 12 — 2 beveiligers actief</span>
              </div>
              <span class="badge green">Veilig</span>
            </div>
            <div class="loc-item">
              <div class="loc-dot orange"></div>
              <div class="loc-info">
                <strong>Utrecht Kantoor</strong>
                <span>Stadsplateau 1 — 0 van 1 bezet</span>
              </div>
              <span class="badge orange">Aandacht</span>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <h3>Recente Meldingen</h3>
          <button class="btn-sm">Alle meldingen →</button>
        </div>
        <div class="table-scroll">
          <table class="dtable">
            <thead><tr><th>Datum & Tijd</th><th>Locatie</th><th>Omschrijving</th><th>Status</th></tr></thead>
            <tbody>
              <tr>
                <td>06 mei 2025 — 14:32</td>
                <td>Amsterdam HQ</td>
                <td>Ongeautoriseerde bezoekers aangetroffen bij ingang B</td>
                <td><span class="badge green">Opgelost</span></td>
              </tr>
              <tr>
                <td>02 mei 2025 — 09:15</td>
                <td>Rotterdam Depot</td>
                <td>Gepland alarmtest uitgevoerd</td>
                <td><span class="badge grey">Geen actie</span></td>
              </tr>
              <tr>
                <td>28 apr 2025 — 21:40</td>
                <td>Amsterdam HQ</td>
                <td>Verdacht voertuig parkeerterrein — rondes verhoogd</td>
                <td><span class="badge orange">In behandeling</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ── PLANNING ── -->
    <section id="tab-planning" class="tab-content hidden">
      <div class="card">
        <div class="card-head">
          <h3>Roostering — Week 19 (5 t/m 11 mei 2025)</h3>
          <div class="btn-group">
            <button class="btn-sm">← Vorige week</button>
            <button class="btn-sm">Volgende week →</button>
          </div>
        </div>
        <div class="table-scroll">
          <table class="dtable planning">
            <thead>
              <tr>
                <th>Beveiliger</th><th>Functie</th><th>Locatie</th>
                <th>Ma</th><th>Di</th><th>Wo</th><th>Do</th><th>Vr</th><th>Za</th><th>Zo</th>
                <th>Kwalificaties</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><div class="guard"><div class="gav blue">JV</div>Jan de Vries</div></td>
                <td><span class="role-badge sr">Sr. Beveiliger</span></td>
                <td>Amsterdam HQ</td>
                <td><span class="shift d">06–14</span></td><td><span class="shift d">06–14</span></td>
                <td><span class="shift d">06–14</span></td><td><span class="shift d">06–14</span></td>
                <td><span class="shift d">06–14</span></td>
                <td class="off">—</td><td class="off">—</td>
                <td><span class="cert">BHV</span><span class="cert">EHBO</span></td>
              </tr>
              <tr>
                <td><div class="guard"><div class="gav orange">FE</div>Fatima el Amrani</div></td>
                <td><span class="role-badge">Beveiliger</span></td>
                <td>Amsterdam HQ</td>
                <td><span class="shift m">14–22</span></td><td><span class="shift m">14–22</span></td>
                <td><span class="shift m">14–22</span></td><td><span class="shift m">14–22</span></td>
                <td><span class="shift m">14–22</span></td>
                <td class="off">—</td><td class="off">—</td>
                <td><span class="cert">BHV</span></td>
              </tr>
              <tr>
                <td><div class="guard"><div class="gav blue">SB</div>Stefan Bakker</div></td>
                <td><span class="role-badge">Beveiliger</span></td>
                <td>Amsterdam HQ</td>
                <td class="off">—</td><td class="off">—</td><td class="off">—</td><td class="off">—</td><td class="off">—</td>
                <td><span class="shift d">06–18</span></td><td><span class="shift d">06–18</span></td>
                <td>—</td>
              </tr>
              <tr>
                <td><div class="guard"><div class="gav blue">RK</div>Ravi Krishnan</div></td>
                <td><span class="role-badge sr">Sr. Beveiliger</span></td>
                <td>Amsterdam HQ</td>
                <td><span class="shift n">22–06</span></td><td><span class="shift n">22–06</span></td>
                <td><span class="shift n">22–06</span></td><td><span class="shift n">22–06</span></td>
                <td><span class="shift n">22–06</span></td>
                <td class="off">—</td><td class="off">—</td>
                <td><span class="cert">BHV</span></td>
              </tr>
              <tr>
                <td><div class="guard"><div class="gav orange">MS</div>Maria Santos</div></td>
                <td><span class="role-badge">Beveiliger</span></td>
                <td>Rotterdam Depot</td>
                <td><span class="shift d">08–16</span></td><td><span class="shift d">08–16</span></td>
                <td><span class="shift d">08–16</span></td><td><span class="shift d">08–16</span></td>
                <td><span class="shift d">08–16</span></td>
                <td><span class="shift d">08–16</span></td><td class="off">—</td>
                <td><span class="cert">BHV</span></td>
              </tr>
              <tr>
                <td><div class="guard"><div class="gav blue">KP</div>Kevin Prins</div></td>
                <td><span class="role-badge">Beveiliger</span></td>
                <td>Rotterdam Depot</td>
                <td><span class="shift m">16–00</span></td><td><span class="shift m">16–00</span></td>
                <td><span class="shift m">16–00</span></td><td><span class="shift m">16–00</span></td>
                <td><span class="shift m">16–00</span></td>
                <td><span class="shift m">16–00</span></td><td><span class="shift m">16–00</span></td>
                <td>—</td>
              </tr>
              <tr class="sick-row">
                <td><div class="guard"><div class="gav grey">LH</div>Lotte Hendriks</div></td>
                <td><span class="role-badge">Beveiliger</span></td>
                <td>Utrecht Kantoor</td>
                <td colspan="7" class="sick-cell">🤒 Ziekmelding — week 19 · vervanging aangevraagd</td>
                <td><span class="cert">BHV</span></td>
              </tr>
              <tr class="open-row">
                <td colspan="11">
                  <span>⚠ Utrecht Kantoor — 1 openstaande positie</span>
                  <button class="btn-orange">Vervanging aanvragen</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ── WIJZIGINGEN ── -->
    <section id="tab-wijzigingen" class="tab-content hidden">
      <div class="two-col">
        <div class="card">
          <div class="card-head"><h3>Nieuw Verzoek Indienen</h3></div>
          <form class="pform">
            <div class="fg">
              <label>Type verzoek</label>
              <select>
                <option>Extra inzet aanvragen</option>
                <option>Instructies wijzigen</option>
                <option>Incident escaleren</option>
                <option>Vervanging aanvragen</option>
                <option>Overige</option>
              </select>
            </div>
            <div class="fg">
              <label>Locatie</label>
              <select>
                <option>Amsterdam HQ — Herengracht 450</option>
                <option>Rotterdam Depot — Waalhaven 12</option>
                <option>Utrecht Kantoor — Stadsplateau 1</option>
              </select>
            </div>
            <div class="fg">
              <label>Datum</label>
              <input type="date" value="2025-05-10" />
            </div>
            <div class="fg">
              <label>Omschrijving</label>
              <textarea rows="4" placeholder="Beschrijf uw verzoek..."></textarea>
            </div>
            <div class="fg">
              <label>Urgentie</label>
              <div class="radio-row">
                <label><input type="radio" name="urg" /> Laag</label>
                <label><input type="radio" name="urg" checked /> Normaal</label>
                <label><input type="radio" name="urg" /> Hoog</label>
              </div>
            </div>
            <button type="button" class="btn-primary" id="submit-btn">Verzoek Indienen</button>
            <div id="success-msg" class="success-msg hidden">✓ Verzoek ontvangen — u ontvangt een bevestiging per e-mail</div>
          </form>
        </div>

        <div class="card">
          <div class="card-head"><h3>Recente Verzoeken</h3></div>
          <div class="req-list">
            <div class="req-item">
              <div class="req-info">
                <strong>Extra inzet — Koningsdag</strong>
                <span>Amsterdam HQ · 27 apr 2025</span>
              </div>
              <span class="badge green">Goedgekeurd</span>
            </div>
            <div class="req-item">
              <div class="req-info">
                <strong>Instructie update receptie</strong>
                <span>Amsterdam HQ · 20 apr 2025</span>
              </div>
              <span class="badge green">Verwerkt</span>
            </div>
            <div class="req-item">
              <div class="req-info">
                <strong>Verhoog nachtronde frequentie</strong>
                <span>Rotterdam Depot · 1 apr 2025</span>
              </div>
              <span class="badge orange">In behandeling</span>
            </div>
            <div class="req-item">
              <div class="req-info">
                <strong>Toegangspas deactiveren #A-042</strong>
                <span>Amsterdam HQ · 15 mrt 2025</span>
              </div>
              <span class="badge green">Verwerkt</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── DOCUMENTEN ── -->
    <section id="tab-documenten" class="tab-content hidden">
      <div class="card">
        <div class="card-head">
          <h3>Documentenbeheer</h3>
          <button class="btn-primary-sm">+ Uploaden</button>
        </div>
        <div class="table-scroll">
          <table class="dtable">
            <thead>
              <tr><th>Document</th><th>Type</th><th>Datum</th><th>Geldig t/m</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
              <tr>
                <td><div class="doc-name">📋 Beveiligingsplan 2024–2025</div></td>
                <td>Plan</td><td>01 jan 2024</td><td>31 dec 2025</td>
                <td><span class="badge green">Geldig</span></td>
                <td><button class="btn-xs">↓ PDF</button></td>
              </tr>
              <tr>
                <td><div class="doc-name">📋 Instructiekaart Amsterdam HQ v3</div></td>
                <td>Instructie</td><td>15 mrt 2025</td><td>—</td>
                <td><span class="badge green">Geldig</span></td>
                <td><button class="btn-xs">↓ PDF</button></td>
              </tr>
              <tr>
                <td><div class="doc-name">📊 Risicoanalyse Q1 2025</div></td>
                <td>Rapportage</td><td>1 apr 2025</td><td>—</td>
                <td><span class="badge green">Geldig</span></td>
                <td><button class="btn-xs">↓ PDF</button></td>
              </tr>
              <tr>
                <td><div class="doc-name">💶 Factuur April 2025</div></td>
                <td>Factuur</td><td>30 apr 2025</td><td>—</td>
                <td><span class="badge green">Betaald</span></td>
                <td><button class="btn-xs">↓ PDF</button></td>
              </tr>
              <tr>
                <td><div class="doc-name">📋 Dienstverleningsovereenkomst 2024</div></td>
                <td>Contract</td><td>01 jan 2024</td><td>31 dec 2025</td>
                <td><span class="badge green">Actief</span></td>
                <td><button class="btn-xs">↓ PDF</button></td>
              </tr>
              <tr>
                <td><div class="doc-name">🏆 ISO 9001 Certificaat NL Security</div></td>
                <td>Certificaat</td><td>01 jul 2024</td><td>30 jun 2025</td>
                <td><span class="badge orange">Verloopt binnenkort</span></td>
                <td><button class="btn-xs">↓ PDF</button></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ── ANALYSE ── -->
    <section id="tab-analyse" class="tab-content hidden">
      <div class="two-col">
        <div class="card">
          <div class="card-head"><h3>Incidenten per Maand — 2025</h3></div>
          <div class="chart-wrap tall">
            <div class="bar-chart" id="analyse-chart">
              <div class="bar-col"><div class="bar" data-base="20"></div><span>jan</span></div>
              <div class="bar-col"><div class="bar" data-base="5"></div><span>feb</span></div>
              <div class="bar-col"><div class="bar accent" data-base="62"></div><span>mrt</span></div>
              <div class="bar-col"><div class="bar" data-base="40"></div><span>apr</span></div>
              <div class="bar-col"><div class="bar" data-base="40"></div><span>mei</span></div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head"><h3>Statistieken</h3></div>
          <div class="stat-rows">
            <div class="stat-row"><span>Gem. responstijd</span><strong>3.2 min</strong></div>
            <div class="stat-row"><span>Snelste respons</span><strong>1.1 min</strong></div>
            <div class="stat-row"><span>Langzaamste respons</span><strong>8.4 min</strong></div>
            <div class="stat-row"><span>Totaal incidenten 2025</span><strong>8</strong></div>
            <div class="stat-row"><span>Opgelost binnen 1 uur</span><strong class="good">100%</strong></div>
            <div class="stat-row"><span>Bezettingsgraad YTD</span><strong>97.1%</strong></div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <h3>Maandrapportage April 2025</h3>
          <button class="btn-sm">↓ PDF downloaden</button>
        </div>
        <div class="report-text">
          <p>In april 2025 zijn er <strong>2 incidenten</strong> geregistreerd op uw locaties. Beide zijn binnen 30 minuten opgelost zonder verdere escalatie. De bezettingsgraad lag op <strong>98.5%</strong>, met één geplande afwezigheid wegens verlof.</p>
          <p>Op basis van de trendanalyse is de incidentfrequentie stabiel en binnen de verwachte marges. Er zijn geen aanpassingen in het beveiligingsplan nodig voor de komende periode. Aanbeveling: vervanging Lotte Hendriks (Utrecht) formeel vastleggen voor week 20.</p>
        </div>
      </div>
    </section>

    <!-- ── CONTACT ── -->
    <section id="tab-contact" class="tab-content hidden">
      <div class="contact-grid">
        <div class="card contact-card">
          <div class="contact-av blue">MvdB</div>
          <h3>Marc van den Berg</h3>
          <p class="contact-role">Uw vaste accountmanager</p>
