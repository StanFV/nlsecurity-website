---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Over Ons">
  <Navigation />
  
  <main class="page-about">
    <!-- Story Hero -->
    <section class="about-hero">
      <div class="container text-center reveal">
        <span class="badge">Sinds 2006</span>
        <h1>Passie voor <br/><span class="orange-text">Veiligheid</span></h1>
        <p class="lead max-700 mx-auto">NL Security zorgt voor uw Veiligheid en Beveiliging. De wereld verandert, behoeften veranderen. Wij stellen ons dagelijks de vraag: hoe houden we deze nieuwe wereld veilig?</p>
      </div>
      
      <div class="container-large reveal" style="transition-delay: 0.2s; margin-top: 4rem;">
        <img src={`${import.meta.env.BASE_URL}/assets/images/banner-city.png`} alt="Over NL Security" class="about-banner-img" />
      </div>
    </section>

    <!-- Vision Blocks -->
    <section class="vision-blocks bg-light">
      <div class="container">
        <div class="grid grid-2">
          <div class="vision-card glass reveal">
            <h2>Onze <span class="orange-text">Visie</span></h2>
            <p>Welke instrumenten passen bij razendsnelle ontwikkelingen? Meer cameratoezicht, meer beveiligers on the spot, of dranghekken? Wij toetsen continu of wij nog de meest passende antwoorden hebben op de veiligheidsvraagstukken van vandaag en morgen.</p>
          </div>
          <div class="vision-card glass reveal" style="transition-delay: 0.1s">
            <h2>NL Security <span class="brand-blue-text">Ontzorgt</span></h2>
            <p>Wij ontzorgen onze relaties volledig op het gebied van veiligheid. De synergie binnen onze diverse specialisaties vormt een krachtig instrument om uw eigendommen en mensen optimaal te beschermen.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Envido Group Section -->
    <section class="envido-section">
      <div class="container">
        <div class="envido-banner reveal">
          <div class="envido-content">
            <h2>Onderdeel van de <span class="orange-text">Envido Groep</span></h2>
            <p>NL Security is onderdeel van de Envido Groep. Hiermee hebben wij een solide moedermaatschappij die stabiliteit, professionaliteit en duurzame groei waarborgt. Deze samenwerking stelt ons in staat om op elk niveau topkwaliteit te leveren.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="core-values bg-light">
      <div class="container">
        <h2 class="text-center reveal">Onze <span class="orange-text">Kernwaarden</span></h2>
        <div class="grid grid-3">
          <div class="value-item reveal">
            <div class="value-num">01</div>
            <h3>Scherpte</h3>
            <p>Alertheid is onze natuur. Wij zien wat anderen missen door onze preventieve focus.</p>
          </div>
          <div class="value-item reveal" style="transition-delay: 0.1s">
            <div class="value-num">02</div>
            <h3>Integriteit</h3>
            <p>Vertrouwen is de basis. Onze beveiliger is loyaal, integer en representatief.</p>
          </div>
          <div class="value-item reveal" style="transition-delay: 0.2s">
            <div class="value-num">03</div>
            <h3>Vakmanschap</h3>
            <p>Ons team is goed getraind en bijzonder ervaren in uiteenlopende situaties.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  .items-center { align-items: center; }
  .text-center { text-align: center; }
  .bg-light { background-color: var(--bg-light); }
  .brand-blue-text { color: var(--brand-blue); }

  .mx-auto { margin-left: auto; margin-right: auto; }
  .max-700 { max-width: 700px; }

  .about-hero {
    padding: 12rem 1rem 4rem;
  }

  .about-hero h1 {
    font-size: 4.5rem;
    margin-bottom: 2rem;
  }

  .container-large {
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 2rem;
  }

  .about-banner-img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: 40px;
    box-shadow: 0 40px 80px rgba(0,0,0,0.1);
  }

  .vision-blocks {
    padding: 10rem 1rem;
  }

  .vision-card {
    padding: 5rem;
    border-radius: 40px;
    background: white;
  }

  .vision-card h2 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .envido-section {
    padding: 5rem 1rem;
  }

  .envido-banner {
    padding: 6rem;
    background: white;
    border-radius: 40px;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 20px 40px rgba(0,0,0,0.02);
    text-align: center;
  }

  .envido-content h2 {
    font-size: 3rem;
    margin-bottom: 2rem;
  }

  .envido-content p {
    font-size: 1.25rem;
    max-width: 900px;
    margin: 0 auto;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .core-values {
    padding: 10rem 1rem;
  }

  .core-values h2 {
    font-size: 3.5rem;
    margin-bottom: 5rem;
  }

  .value-item {
    padding: 3rem;
    border-radius: 24px;
    background: white;
    transition: 0.3s;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  }

  .value-item:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }

  .value-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--brand-orange);
    margin-bottom: 1.5rem;
  }

  .value-item h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
    .about-hero h1 { font-size: 3rem; }
    .vision-card { padding: 3rem; }
    .envido-banner { padding: 3rem; }
  }
</style>
