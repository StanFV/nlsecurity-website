---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Over Ons">
  <Navigation />
  
  <main class="page-about">
    <!-- Story Hero -->
    <section class="about-hero">
      <div class="container text-center reveal">
        <span class="badge">Sinds 2006</span>
        <h1>Passie voor <br/><span class="orange-text">Veiligheid</span></h1>
        <p class="lead max-700 mx-auto">NL Security zorgt voor uw Veiligheid en Beveiliging. De wereld verandert, behoeften veranderen. Wij stellen ons dagelijks de vraag: hoe houden we deze nieuwe wereld veilig?</p>
      </div>
      
      <div class="container-large reveal" style="transition-delay: 0.2s; margin-top: 4rem;">
        <img src={`${import.meta.env.BASE_URL}/assets/images/banner-city.png`} alt="Over NL Security" class="about-banner-img" />
      </div>
    </section>

    <!-- Vision Blocks -->
    <section class="vision-blocks bg-light">
      <div class="container">
        <div class="grid grid-2">
          <div class="vision-card glass reveal">
            <h2>Onze <span class="orange-text">Visie</span></h2>
            <p>Welke instrumenten passen bij razendsnelle ontwikkelingen? Meer cameratoezicht, meer beveiligers on the spot, of dranghekken? Wij toetsen continu of wij nog de meest passende antwoorden hebben op de veiligheidsvraagstukken van vandaag en morgen.</p>
          </div>
          <div class="vision-card glass reveal" style="transition-delay: 0.1s">
            <h2>NL Security <span class="brand-blue-text">Ontzorgt</span></h2>
            <p>Wij ontzorgen onze relaties volledig op het gebied van veiligheid. De synergie binnen onze diverse specialisaties vormt een krachtig instrument om uw eigendommen en mensen optimaal te beschermen.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Envido Group Section -->
    <section class="envido-section">
      <div class="container">
        <div class="envido-banner reveal">
          <div class="envido-grid">
            <div class="envido-logo-box">
              <a href="https://www.envido.nl" target="_blank" rel="noopener noreferrer">
                <img src={`${import.meta.env.BASE_URL}/assets/images/logo-envido.png`} alt="Envido Logo" class="envido-logo" />
              </a>
            </div>
            <div class="envido-content">
              <span class="badge-blue">Onze Basis</span>
              <h2>Onderdeel van de <span class="orange-text">Envido Groep</span></h2>
              <p>NL Security is trots onderdeel van de Envido Groep. Hiermee hebben wij een solide moedermaatschappij die stabiliteit, professionaliteit en duurzame groei waarborgt. Deze samenwerking stelt ons in staat om op elk niveau topkwaliteit en continuïteit te leveren.</p>
              <div class="envido-action">
                <a href="https://www.envido.nl" target="_blank" rel="noopener noreferrer" class="btn-outline-blue">Bezoek Envido.nl →</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="core-values bg-light">
      <div class="container">
        <h2 class="text-center reveal">Onze <span class="orange-text">Kernwaarden</span></h2>
        <div class="grid grid-3">
          <div class="value-item reveal">
            <div class="value-num">01</div>
            <h3>Scherpte</h3>
            <p>Alertheid is onze natuur. Wij zien wat anderen missen door onze preventieve focus.</p>
          </div>
          <div class="value-item reveal" style="transition-delay: 0.1s">
            <div class="value-num">02</div>
            <h3>Integriteit</h3>
            <p>Vertrouwen is de basis. Onze beveiliger is loyaal, integer en representatief.</p>
          </div>
          <div class="value-item reveal" style="transition-delay: 0.2s">
            <div class="value-num">03</div>
            <h3>Vakmanschap</h3>
            <p>Ons team is goed getraind en bijzonder ervaren in uiteenlopende situaties.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  .items-center { align-items: center; }
  .text-center { text-align: center; }
  .bg-light { background-color: var(--bg-light); }
  .brand-blue-text { color: var(--brand-blue); }

  .mx-auto { margin-left: auto; margin-right: auto; }
  .max-700 { max-width: 700px; }

  .about-hero {
    padding: 8rem 1rem 2rem;
  }

  .about-hero h1 {
    font-size: 4.5rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: 6rem 1rem 1.5rem;
    }
    .about-hero h1 {
      font-size: 2.5rem;
    }
    .about-banner-img {
      height: 250px;
      border-radius: 24px;
    }
    .container-large {
      padding: 0 1rem;
    }
    .vision-blocks {
      padding: 2.5rem 1rem;
    }
    .vision-card {
      padding: 2rem;
      border-radius: 24px;
    }
    .envido-banner {
      padding: 2.5rem 1.5rem;
      border-radius: 24px;
    }
    .envido-content h2 {
      font-size: 1.75rem;
    }
    .core-values {
      padding: 3rem 1rem;
    }
    .core-values h2 {
      font-size: 2.25rem;
      margin-bottom: 2rem;
    }
    .value-item {
      padding: 2rem;
    }
  }

  .container-large {
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 2rem;
  }

  .about-banner-img {
    width: 100%;
    height: 450px;
    object-fit: cover;
    border-radius: 40px;
    box-shadow: 0 40px 80px rgba(0,0,0,0.1);
  }

  .vision-blocks {
    padding: 4rem 1rem;
  }

  .vision-card {
    padding: 3rem;
    border-radius: 40px;
    background: white;
  }

  .vision-card h2 {
    font-size: 2.5rem;
    margin-bottom: 1.25rem;
  }

  .envido-section {
    padding: 3rem 1rem;
    background: var(--bg-light);
  }

  .envido-banner {
    padding: 5rem;
    background: var(--brand-blue);
    border-radius: 48px;
    color: white;
    box-shadow: 0 30px 60px rgba(var(--brand-blue-rgb), 0.2);
    position: relative;
    overflow: hidden;
  }

  .envido-banner::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60%;
    height: 140%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.03) 0%, transparent 70%);
    transform: rotate(-15deg);
  }

  .envido-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 5rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .envido-logo-box {
    background: white;
    padding: 3rem;
    border-radius: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.4s;
    box-shadow: 0 15px 35px rgba(0,0,0,0.2);
  }

  .envido-logo-box:hover {
    transform: scale(1.05);
    box-shadow: 0 20px 45px rgba(0,0,0,0.3);
  }

  .envido-logo {
    max-width: 100%;
    height: auto;
  }

  .envido-content {
    text-align: left;
  }

  .badge-blue {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .envido-content h2 {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    color: white;
  }

  .envido-content p {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .btn-outline-blue {
    display: inline-block;
    color: white;
    text-decoration: none;
    font-weight: 700;
    border-bottom: 2px solid rgba(255, 255, 255, 0.3);
    padding-bottom: 0.5rem;
    transition: 0.3s;
  }

  .btn-outline-blue:hover {
    border-color: var(--brand-orange);
    color: var(--brand-orange);
    padding-left: 0.5rem;
  }

  @media (max-width: 1024px) {
    .envido-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }
    .envido-content {
      text-align: center;
    }
    .envido-logo-box {
      max-width: 300px;
      margin: 0 auto;
    }
    .envido-banner {
      padding: 4rem 2rem;
    }
  }

  .core-values {
    padding: 4rem 1rem;
  }

  .core-values h2 {
    font-size: 3.5rem;
    margin-bottom: 2.5rem;
  }

  .value-item {
    padding: 2.5rem;
    border-radius: 24px;
    background: white;
    transition: 0.3s;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  }

  .value-item:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }

  .value-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--brand-orange);
    margin-bottom: 1.5rem;
  }

  .value-item h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
    .about-hero h1 { font-size: 3rem; }
    .vision-card { padding: 3rem; }
    .envido-banner { padding: 3rem; }
  }
</style>
