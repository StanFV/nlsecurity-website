---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
---

<BaseLayout title="Home">
  <Navigation />

  <main>
    <!-- Hero -->
    <section class="hero-video-light">
      <div class="hero-bg">
        <video autoplay muted loop playsinline class="bg-video">
          <source src={`${import.meta.env.BASE_URL}/assets/video/film.mp4`} type="video/mp4" />
        </video>
        <div class="video-overlay"></div>
      </div>
      
      <div class="container hero-content-center reveal">
        <h1>Welkom bij <br/><span class="orange-text">NL Security</span></h1>
        <p class="hero-tagline">Als beveiligen anders moet — beter moet — scherper moet.</p>
        <p class="hero-description">Met een hecht team van vele honderden beveiligers beschermen wij dagelijks onze en uw eigendommen.</p>
        <div class="hero-actions">
          <button id="play-video" class="btn-glow">Bekijk onze film</button>
          <a href={`${import.meta.env.BASE_URL}/oplossingen`} class="btn-outline-white">Onze diensten</a>
        </div>
      </div>

      <div class="scroll-down-indicator">
        <div class="mouse"></div>
      </div>
    </section>

    <!-- Video Modal -->
    <div id="video-modal" class="video-modal">
      <div class="modal-content">
        <button id="close-modal" class="close-modal">&times;</button>
        <video id="modal-video" controls>
          <source src={`${import.meta.env.BASE_URL}/assets/video/film.mp4`} type="video/mp4" />
        </video>
      </div>
    </div>

    <!-- Floating Call Button -->
    <a href="tel:0880202800" class="floating-call-btn" title="Bel NL Security">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.18-2.18a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      <span>Bel direct</span>
    </a>

    <!-- Marquee Clients -->
    <section class="clients-light bg-light">
      <div class="marquee-container">
        <div class="marquee-content">
          {['Pensioenfonds Horeca', 'Kennisnet', 'Ombudsman', 'Rijksoverheid', 'Lidl', 'Gemeente Lansingerland'].map(name => (
            <div class="client-badge">{name}</div>
          ))}
          {/* Repeat for loop */}
          {['Pensioenfonds Horeca', 'Kennisnet', 'Ombudsman', 'Rijksoverheid', 'Lidl', 'Gemeente Lansingerland'].map(name => (
            <div class="client-badge">{name}</div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="services-modern">
      <div class="container">
        <div class="section-header text-center reveal">
          <h2>Onze <span class="orange-text">Expertise</span></h2>
          <p>Complete ontzorging op elk beveiligingsniveau.</p>
        </div>
        <div class="grid grid-3">
          <div class="service-box reveal">
            <div class="service-icon-wrap">01</div>
            <h3>Objectbeveiliging</h3>
            <p>Scherpe bewaking van uw panden en terreinen door gecertificeerde professionals.</p>
          </div>
          <div class="service-box reveal" style="transition-delay: 0.1s">
            <div class="service-icon-wrap">02</div>
            <h3>Mobiele Surveillance</h3>
            <p>Proactieve rondes en snelle alarmopvolging met onze moderne vloot.</p>
          </div>
          <div class="service-box reveal" style="transition-delay: 0.2s">
            <div class="service-icon-wrap">03</div>
            <h3>Verkeersregelaars</h3>
            <p>Veilige doorstroming en professioneel verkeersbeheer bij elk project.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-modern">
      <div class="container">
        <div class="cta-card glass reveal">
          <div class="cta-content">
            <h2>Klaar voor een <span class="orange-text">vrijblijvende analyse?</span></h2>
            <p>Laat onze experts uw beveiligingssituatie in kaart brengen.</p>
          </div>
          <a href={`${import.meta.env.BASE_URL}/contact`} class="btn-glow">Nu aanvragen</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer-light">
    <div class="container">
      <div class="footer-content">
        <img src={`${import.meta.env.BASE_URL}/assets/images/logo.png`} alt="Logo" class="footer-logo" />
        <p>&copy; 2026 NL Security. Modern, Scherper, Beter.</p>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  .items-center { align-items: center; }
  .text-center { text-align: center; }
  .bg-light { background-color: var(--bg-light); }

  .hero-video-light {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    color: white;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.5); /* Licht filter voor wit thema */
    backdrop-filter: blur(2px);
  }

  .hero-content-center {
    max-width: 900px;
    z-index: 1;
  }

  .hero-content-center h1 {
    font-size: 5rem;
    margin-bottom: 1rem;
    color: var(--brand-blue);
  }

  .hero-tagline {
    font-size: 1.8rem !important;
    color: var(--brand-orange) !important;
    margin-bottom: 1.5rem !important;
    font-weight: 700 !important;
    line-height: 1.2;
  }

  .hero-description {
    font-size: 1.2rem !important;
    color: #444 !important;
    margin-bottom: 3.5rem !important;
    font-weight: 500 !important;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .white-badge {
    background: white !important;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
  }

  .btn-glow, .btn-outline-white {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    padding: 0 2.5rem;
    border-radius: 50px;
    font-weight: bold;
    text-decoration: none;
    transition: 0.3s;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .btn-glow {
    background: var(--brand-orange);
    color: white;
    border: none;
  }

  .btn-outline-white {
    border: 2px solid var(--brand-blue);
    color: var(--brand-blue);
    background: white;
  }

  .btn-outline-white:hover {
    background: var(--brand-blue);
    color: white;
  }

  .scroll-down-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .mouse {
    width: 25px;
    height: 45px;
    border: 2px solid var(--brand-blue);
    border-radius: 20px;
    position: relative;
  }

  .mouse::after {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    width: 4px;
    height: 8px;
    background: var(--brand-blue);
    transform: translateX(-50%);
    border-radius: 2px;
    animation: scroll-mouse 2s infinite;
  }

  @keyframes scroll-mouse {
    0% { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; transform: translate(-50%, 20px); }
  }

  .video-preview-card {
    padding: 1rem;
    border-radius: 24px;
    position: relative;
    box-shadow: 0 30px 60px rgba(0,0,0,0.1);
  }

  .preview-video {
    width: 100%;
    border-radius: 16px;
    display: block;
  }

  .card-tag {
    position: absolute;
    top: 2rem;
    left: 2rem;
    background: var(--brand-orange);
    color: white;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: bold;
  }

  .clients-light {
    padding: 3rem 0;
    overflow: hidden;
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .marquee-content {
    display: flex;
    gap: 4rem;
    animation: scroll 40s linear infinite;
    width: max-content;
  }

  .client-badge {
    font-weight: 800;
    color: #ddd;
    font-size: 1.5rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .services-modern {
    background-color: var(--bg-white);
  }

  .section-header h2 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .service-box {
    padding: 4rem 3rem;
    background: var(--bg-light);
    border-radius: 24px;
    transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-box:hover {
    background: white;
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
    transform: translateY(-10px);
  }

  .service-box .service-icon-wrap {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--brand-orange);
    width: 60px;
    height: 60px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2.5rem;
    box-shadow: 0 10px 20px rgba(255, 102, 0, 0.1);
  }

  .service-box h3 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .cta-modern {
    padding-bottom: 10rem;
  }

  .cta-card {
    padding: 5rem;
    border-radius: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, #ffffff, #f8f9fa);
  }

  .cta-content h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .footer-light {
    padding: 4rem 0;
    border-top: 1px solid rgba(0,0,0,0.05);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-logo {
    height: 30px;
    opacity: 0.6;
  }

  /* Video Modal Styles */
  .video-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    z-index: 2000;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .video-modal.active {
    display: flex;
  }

  .modal-content {
    position: relative;
    width: 100%;
    max-width: 1200px;
    aspect-ratio: 16 / 9;
  }

  #modal-video {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }

  .close-modal {
    position: absolute;
    top: -3rem;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 3rem;
    cursor: pointer;
    line-height: 1;
  }

  /* Floating Call Button Styles */
  .floating-call-btn {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--brand-orange);
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-weight: bold;
    box-shadow: 0 10px 30px rgba(255, 102, 0, 0.3);
    z-index: 1500;
    transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .floating-call-btn:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 40px rgba(255, 102, 0, 0.4);
    background: var(--brand-blue);
  }

  @media (max-width: 768px) {
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
    .hero-light h1 { font-size: 3rem; }
    .cta-card { flex-direction: column; text-align: center; gap: 3rem; padding: 3rem; }
    .floating-call-btn span { display: none; }
    .floating-call-btn { padding: 1.25rem; border-radius: 50%; }
  }
</style>

<script>
  // Video Modal Logic
  const playBtn = document.getElementById('play-video');
  const closeBtn = document.getElementById('close-modal');
  const modal = document.getElementById('video-modal');
  const modalVideo = document.getElementById('modal-video') as HTMLVideoElement;

  playBtn?.addEventListener('click', () => {
    modal?.classList.add('active');
    modalVideo?.play();
    document.body.style.overflow = 'hidden';
  });

  const closeModal = () => {
    modal?.classList.remove('active');
    modalVideo?.pause();
    modalVideo.currentTime = 0;
    document.body.style.overflow = 'auto';
  };

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>
