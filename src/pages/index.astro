---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Home">
  <Navigation />

  <main>
    <!-- Hero -->
    <section class="hero-video-light">
      <div class="hero-bg">
        <video autoplay muted loop playsinline class="bg-video">
          <source src={`${import.meta.env.BASE_URL}/assets/video/film.mp4`} type="video/mp4" />
        </video>
        <div class="video-overlay"></div>
      </div>
      
      <div class="container hero-content-center reveal">
        <h1>Welkom bij <br/><span class="orange-text">NL Security</span></h1>
        <p class="hero-tagline">Als beveiligen anders moet — beter moet — scherper moet.</p>
        <p class="hero-description">Met een hecht team van vele honderden beveiligers beschermen wij dagelijks onze en uw eigendommen.</p>
        <div class="hero-actions">
          <button id="play-video" class="btn-glow">Bekijk onze film</button>
          <a href={`${import.meta.env.BASE_URL}/oplossingen`} class="btn-outline-white">Onze diensten</a>
        </div>
      </div>

      <div class="scroll-down-indicator">
        <div class="mouse"></div>
      </div>
    </section>

    <!-- Video Modal -->
    <div id="video-modal" class="video-modal">
      <div class="modal-content">
        <button id="close-modal" class="close-modal">&times;</button>
        <video id="modal-video" controls>
          <source src={`${import.meta.env.BASE_URL}/assets/video/film.mp4`} type="video/mp4" />
        </video>
      </div>
    </div>

    <!-- Floating Call Button -->
    <a href="tel:0880202800" class="floating-call-btn" title="Bel NL Security">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.18-2.18a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      <span>Bel direct</span>
    </a>

    <!-- Marquee Clients -->
    <section class="clients-light bg-light">
      <div class="marquee-container">
        <div class="marquee-content">
          {[
            { name: 'Pensioenfonds Horeca', logo: 'Pensioenfonds Horeca Logo.jpg' },
            { name: 'Kennisnet', logo: 'Kennisnet logo.png' },
            { name: 'Ombudsman', logo: 'Ombudsman logo.png' },
            { name: 'Rijksoverheid', logo: 'Rijksoverheid logo.png' },
            { name: 'Lidl', logo: 'Lidl_logo-700x700.jpg.jpg' },
            { name: 'Gemeente Lansingerland', logo: 'Gemeente Lansingerland logo.png' }
          ].map(client => (
            <div class="client-logo-wrap">
              <img src={`${import.meta.env.BASE_URL}/assets/images/${client.logo}`} alt={client.name} class="client-logo" />
            </div>
          ))}
          {/* Repeat for infinite scroll */}
          {[
            { name: 'Pensioenfonds Horeca', logo: 'Pensioenfonds Horeca Logo.jpg' },
            { name: 'Kennisnet', logo: 'Kennisnet logo.png' },
            { name: 'Ombudsman', logo: 'Ombudsman logo.png' },
            { name: 'Rijksoverheid', logo: 'Rijksoverheid logo.png' },
            { name: 'Lidl', logo: 'Lidl_logo-700x700.jpg.jpg' },
            { name: 'Gemeente Lansingerland', logo: 'Gemeente Lansingerland logo.png' }
          ].map(client => (
            <div class="client-logo-wrap">
              <img src={`${import.meta.env.BASE_URL}/assets/images/${client.logo}`} alt={client.name} class="client-logo" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="services-modern">
      <div class="container">
        <div class="section-header text-center reveal">
          <span class="badge-blue">Onze Diensten</span>
          <h2>Gespecialiseerde <span class="orange-text">Expertise</span></h2>
          <p class="max-600 mx-auto">Wij bieden een breed scala aan beveiligingsoplossingen, altijd afgestemd op uw specifieke behoeften en risicoprofiel.</p>
        </div>
        <div class="grid grid-3">
          <div class="service-card reveal">
            <div class="card-icon">01</div>
            <h3>Objectbeveiliging</h3>
            <p>Scherpe bewaking van uw panden en terreinen door gecertificeerde professionals die weten wat er speelt.</p>
            <a href={`${import.meta.env.BASE_URL}/oplossingen`} class="card-link">Lees meer <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
          </div>
          <div class="service-card reveal" style="transition-delay: 0.1s">
            <div class="card-icon">02</div>
            <h3>Mobiele Surveillance</h3>
            <p>Proactieve rondes en razendsnelle alarmopvolging met onze moderne vloot en deskundige surveillanten.</p>
            <a href={`${import.meta.env.BASE_URL}/oplossingen`} class="card-link">Lees meer <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
          </div>
          <div class="service-card reveal" style="transition-delay: 0.2s">
            <div class="card-icon">03</div>
            <h3>Verkeersregelaars</h3>
            <p>Veilige doorstroming en professioneel verkeersbeheer bij elk project, van bouwlocatie tot groot evenement.</p>
            <a href={`${import.meta.env.BASE_URL}/oplossingen`} class="card-link">Lees meer <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-box-elite reveal">
          <div class="cta-content">
            <span class="badge-white">Vrijblijvend Advies</span>
            <h2>Klaar voor een <span class="orange-text">veiligere toekomst?</span></h2>
            <p>Laat onze experts uw huidige beveiligingssituatie analyseren en ontdek hoe het scherper en beter kan.</p>
            <div class="cta-actions">
              <a href={`${import.meta.env.BASE_URL}/contact`} class="btn-glow">Nu Analyse Aanvragen</a>
              <a href="tel:0880202800" class="btn-outline-white-real">Bel direct: 088 - 02 02 800</a>
            </div>
          </div>
          <div class="cta-visual">
            <div class="floating-card">
              <span class="stat">24/7</span>
              <span class="label">Dienstverlening</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .items-center { align-items: center; }
  .text-center { text-align: center; }
  .bg-light { background-color: var(--bg-light); }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .max-600 { max-width: 600px; }

  /* Hero Adjustments */
  .hero-video-light {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    color: white;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 20, 40, 0.6);
    backdrop-filter: blur(2px);
  }

  .hero-content-center {
    max-width: 900px;
    z-index: 1;
  }

  .hero-content-center h1 {
    font-size: 5rem;
    margin-bottom: 1.5rem;
    color: white;
    line-height: 1;
  }

  .hero-tagline {
    font-size: 1.8rem !important;
    color: var(--brand-orange) !important;
    margin-bottom: 1.5rem !important;
    font-weight: 700 !important;
    line-height: 1.2;
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
  }

  .hero-description {
    font-size: 1.2rem !important;
    color: rgba(255, 255, 255, 0.9) !important;
    margin-bottom: 3.5rem !important;
    font-weight: 500 !important;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 768px) {
    .hero-content-center h1 {
      font-size: 2.75rem;
      margin-bottom: 1rem;
    }
    .hero-tagline {
      font-size: 1.4rem !important;
      margin-bottom: 1rem !important;
    }
    .hero-description {
      font-size: 1rem !important;
      margin-bottom: 2.5rem !important;
    }
    .hero-actions {
      flex-direction: column;
      gap: 1rem;
    }
    .btn-glow, .btn-outline-white {
      width: 100%;
      max-width: 300px;
    }
  }

  .btn-glow, .btn-outline-white {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    padding: 0 2.5rem;
    border-radius: 50px;
    font-weight: bold;
    text-decoration: none;
    transition: 0.3s;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .btn-glow {
    background: var(--brand-orange);
    color: white;
    border: none;
  }

  .btn-outline-white {
    border: 2px solid var(--brand-blue);
    color: white;
    background: var(--brand-blue);
    font-weight: 800;
  }

  .btn-outline-white:hover {
    background: transparent;
    color: var(--brand-blue);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 46, 93, 0.18);
  }

  /* Marquee */
  .clients-light {
    padding: 4rem 0;
    background: #fdfdfd;
    border-top: 1px solid rgba(0,0,0,0.03);
    border-bottom: 1px solid rgba(0,0,0,0.03);
  }

  .marquee-container {
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .marquee-content {
    display: flex;
    gap: 5rem;
    animation: scroll 40s linear infinite;
    width: max-content;
    padding-left: 2.5rem; /* Give some initial space */
  }

  .client-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 60px;
  }

  .client-logo {
    max-height: 45px;
    filter: grayscale(100%);
    opacity: 0.4;
    transition: 0.4s;
  }

  .client-logo:hover {
    filter: grayscale(0%);
    opacity: 1;
  }

  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Services Redesign */
  .services-modern {
    padding: 10rem 0;
    background: var(--brand-blue);
    color: white;
    position: relative;
    overflow: hidden;
  }

  .services-modern::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 100% 0%, rgba(255, 102, 0, 0.05) 0%, transparent 40%);
    pointer-events: none;
  }

  .section-header {
    margin-bottom: 5rem;
  }

  .badge-blue {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .section-header h2 {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    color: white;
  }

  .section-header p {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.8;
  }

  .service-card {
    background: rgba(255, 255, 255, 0.03);
    padding: 4rem 3rem;
    border-radius: 40px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    transition: 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .service-card:hover {
    transform: translateY(-15px);
    background: rgba(255, 255, 255, 0.07);
    border-color: var(--brand-orange);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
  }

  .card-icon {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--brand-orange);
    margin-bottom: 2.5rem;
    width: 65px;
    height: 65px;
    background: rgba(255, 102, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    transition: 0.4s;
  }

  .service-card:hover .card-icon {
    background: var(--brand-orange);
    color: white;
    transform: rotate(5deg) scale(1.1);
  }

  .service-card h3 {
    font-size: 1.85rem;
    margin-bottom: 1.25rem;
    color: white;
  }

  .service-card p {
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 2.5rem;
    line-height: 1.8;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--brand-orange);
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition: 0.3s;
  }

  .card-link:hover {
    gap: 1.25rem;
  }

  /* CTA Redesign */
  .cta-section {
    padding: 3rem 0 8rem;
  }

  .cta-box-elite {
    background: var(--brand-blue);
    padding: 6rem;
    border-radius: 48px;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    align-items: center;
    color: white;
    position: relative;
    overflow: hidden;
    box-shadow: 0 40px 80px rgba(var(--brand-blue-rgb), 0.25);
  }

  .cta-box-elite::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 80%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
    transform: rotate(-15deg);
  }

  .badge-white {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2rem;
  }

  .cta-content h2 {
    font-size: 3.5rem;
    color: white;
    margin-bottom: 1.5rem;
  }

  .cta-content p {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 3.5rem;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .btn-outline-white-real {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    padding: 0 2.5rem;
    border-radius: 50px;
    font-weight: 800;
    text-decoration: none;
    transition: 0.3s;
    white-space: nowrap;
    background: white;
    color: var(--brand-blue);
    border: 2px solid white;
  }

  .btn-outline-white-real:hover {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
    color: white;
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .cta-visual {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .floating-card {
    background: white;
    padding: 3rem;
    border-radius: 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    box-shadow: 0 30px 60px rgba(0,0,0,0.2);
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  .floating-card .stat {
    font-size: 4rem;
    font-weight: 900;
    color: var(--brand-orange);
    line-height: 1;
  }

  .floating-card .label {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--brand-blue);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 0.5rem;
  }

  /* Shared Components from index.astro */
  .scroll-down-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .mouse {
    width: 25px;
    height: 45px;
    border: 2px solid var(--brand-blue);
    border-radius: 20px;
    position: relative;
  }

  .mouse::after {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    width: 4px;
    height: 8px;
    background: var(--brand-blue);
    transform: translateX(-50%);
    border-radius: 2px;
    animation: scroll-mouse 2s infinite;
  }

  @keyframes scroll-mouse {
    0% { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; transform: translate(-50%, 20px); }
  }

  /* Video Modal Styles */
  .video-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    z-index: 2000;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .video-modal.active {
    display: flex;
  }

  .modal-content {
    position: relative;
    width: 100%;
    max-width: 1200px;
    aspect-ratio: 16 / 9;
  }

  #modal-video {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }

  .close-modal {
    position: absolute;
    top: -3rem;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 3rem;
    cursor: pointer;
    line-height: 1;
  }

  /* Floating Call Button Styles */
  .floating-call-btn {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--brand-orange);
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-weight: bold;
    box-shadow: 0 10px 30px rgba(255, 102, 0, 0.3);
    z-index: 1500;
    transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .floating-call-btn:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 40px rgba(255, 102, 0, 0.4);
    background: var(--brand-blue);
  }

  @media (max-width: 1024px) {
    .cta-box-elite {
      grid-template-columns: 1fr;
      padding: 4rem;
      text-align: center;
    }
    .cta-actions {
      justify-content: center;
    }
    .cta-visual {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .grid-3 { grid-template-columns: 1fr; }
    .section-header h2 { font-size: 2.25rem; }
    .cta-content h2 { font-size: 2.25rem; }
    .floating-call-btn span { display: none; }
    .floating-call-btn { padding: 1.25rem; border-radius: 50%; }
    
    .service-card {
      padding: 3rem 2rem;
    }
    
    .services-modern {
      padding: 6rem 0;
    }
  }
</style>

<script>
  // Video Modal Logic
  const playBtn = document.getElementById('play-video');
  const closeBtn = document.getElementById('close-modal');
  const modal = document.getElementById('video-modal');
  const modalVideo = document.getElementById('modal-video') as HTMLVideoElement;

  playBtn?.addEventListener('click', () => {
    modal?.classList.add('active');
    modalVideo?.play();
    document.body.style.overflow = 'hidden';
  });

  const closeModal = () => {
    modal?.classList.remove('active');
    modalVideo?.pause();
    modalVideo.currentTime = 0;
    document.body.style.overflow = 'auto';
  };

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>
