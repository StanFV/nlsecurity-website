---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Contact">
  <Navigation />
  
  <main class="page-contact">
    <!-- Hero -->
    <section class="contact-hero">
      <div class="container text-center reveal">
        <span class="badge-blue">Neem Contact Op</span>
        <h1>Zorg nu voor optimale <br/><span class="gradient-text">Beveiliging</span></h1>
        <p class="lead max-700 mx-auto">Heeft u vragen over onze diensten of wilt u een directe offerte? Onze experts staan voor u klaar om uw veiligheid naar een hoger niveau te tillen.</p>
      </div>
    </section>

    <section class="contact-grid-elite">
      <div class="container grid grid-2">
        <!-- Form Column -->
        <div class="contact-form-elite glass reveal">
          <div id="form-container">
            <h2>Stuur een <span class="orange-text">bericht</span></h2>
            <p class="form-intro">Laat uw gegevens achter en wij nemen binnen 24 uur contact met u op.</p>
            <form class="elite-form" id="contact-form" action="https://formspree.io/f/xaqvpjzv" method="POST">
              <div class="form-row">
                <input type="text" name="name" placeholder="Volledige naam" required />
                <input type="email" name="email" placeholder="E-mailadres" required />
              </div>
              <input type="tel" name="phone" placeholder="Telefoonnummer" />
              <textarea name="message" placeholder="Waarmee kunnen we u helpen?" rows="6" required></textarea>
              <button type="submit" id="submit-btn" class="btn-glow">Bericht Verzenden</button>
            </form>
          </div>
          <div id="success-message" style="display: none; text-align: center; padding: 3rem 0;">
            <div style="font-size: 4rem; margin-bottom: 1.5rem;">✅</div>
            <h2 class="orange-text">Bericht verzonden!</h2>
            <p style="font-size: 1.2rem; color: var(--text-secondary); line-height: 1.6;">Bedankt voor uw bericht. Wij hebben uw aanvraag ontvangen en nemen binnen 24 uur contact met u op.</p>
          </div>
          <div id="error-message" style="display: none; text-align: center; padding: 1rem; color: #dc3545; background: rgba(220, 53, 69, 0.1); border-radius: 12px; margin-top: 1rem;">
            Oeps! Er ging iets mis bij het verzenden. Probeer het later opnieuw.
          </div>
        </div>

        <script is:inline>
          const form = document.getElementById('contact-form');
          const formContainer = document.getElementById('form-container');
          const successMessage = document.getElementById('success-message');
          const errorMessage = document.getElementById('error-message');
          const submitBtn = document.getElementById('submit-btn');

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            // Show loading state
            submitBtn.disabled = true;
            submitBtn.innerText = 'Verzenden...';
            errorMessage.style.display = 'none';

            const formData = new FormData(form);
            
            try {
              const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                  'Accept': 'application/json'
                }
              });

              if (response.ok) {
                formContainer.style.display = 'none';
                successMessage.style.display = 'block';
              } else {
                const data = await response.json();
                if (data.errors) {
                  errorMessage.innerText = data.errors.map(error => error.message).join(", ");
                } else {
                  errorMessage.innerText = 'Oeps! Er ging iets mis bij het verzenden.';
                }
                errorMessage.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.innerText = 'Bericht Verzenden';
              }
            } catch (error) {
              errorMessage.innerText = 'Oeps! Er ging iets mis met de verbinding.';
              errorMessage.style.display = 'block';
              submitBtn.disabled = false;
              submitBtn.innerText = 'Bericht Verzenden';
            }
          });
        </script>

        <!-- Details Column -->
        <div class="contact-details-elite reveal" style="transition-delay: 0.2s">
          <div class="info-block">
            <span class="detail-label">Onze Vestigingen</span>
            <div class="office-card">
              <div class="office-icon">🏢</div>
              <div class="office-info">
                <h3>Hoofdkantoor Zoetermeer</h3>
                <p>Boerhaavelaan 31, 2713 HA Zoetermeer</p>
              </div>
            </div>
            <div class="office-card">
              <div class="office-icon">📍</div>
              <div class="office-info">
                <h3>Regio Den Haag</h3>
                <p>Stadhouderslaan 9, 2517 HV Den Haag</p>
              </div>
            </div>
          </div>

          <div class="info-block">
            <span class="detail-label">Direct Contact</span>
            <div class="contact-method">
              <span class="method-icon">📞</span>
              <div class="method-text">
                <span class="label">Telefoon</span>
                <a href="tel:0880202800" class="value">088 - 02 02 800</a>
              </div>
            </div>
            <div class="contact-method">
              <span class="method-icon">✉️</span>
              <div class="method-text">
                <span class="label">E-mail</span>
                <a href="mailto:s.hudepohl@bc-capital.nl" class="value">s.hudepohl@bc-capital.nl</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Map Section -->
    <section class="map-section bg-light">
      <div class="container">
        <div class="section-header text-center reveal">
          <h2>Onze <span class="orange-text">Locaties</span></h2>
          <p>Bekijk onze vestigingen in Zoetermeer en Den Haag.</p>
        </div>
        
        <div class="map-container-outer reveal">
          <div id="map" style="height: 500px; border-radius: 32px; box-shadow: 0 20px 50px rgba(0,0,0,0.1); z-index: 1;"></div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const map = L.map('map').setView([52.078, 4.38], 11);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    const locations = [
      {
        name: "Hoofdkantoor Zoetermeer",
        address: "Boerhaavelaan 31, Zoetermeer",
        coords: [52.0722, 4.4842]
      },
      {
        name: "Regio Den Haag",
        address: "Stadhouderslaan 9, Den Haag",
        coords: [52.0886, 4.2831]
      }
    ];

    const orangeIcon = L.divIcon({
      className: 'custom-div-icon',
      html: "<div style='background-color:#FF6600; width:15px; height:15px; border-radius:50%; border:3px solid white; box-shadow: 0 0 10px rgba(0,0,0,0.3);'></div>",
      iconSize: [15, 15],
      iconAnchor: [7, 7]
    });

    locations.forEach(loc => {
      L.marker(loc.coords, {icon: orangeIcon})
        .addTo(map)
        .bindPopup(`<strong>${loc.name}</strong><br>${loc.address}`);
    });

    // Auto fit bounds if possible
    const group = new L.featureGroup(locations.map(loc => L.marker(loc.coords)));
    map.fitBounds(group.getBounds().pad(0.5));
  });
</script>

<style>
  .text-center { text-align: center; }
  .grid { display: grid; gap: 4rem; }
  .grid-2 { grid-template-columns: 1.2fr 0.8fr; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .max-700 { max-width: 700px; }
  .bg-light { background-color: var(--bg-light); }

  .map-container-outer {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .leaflet-popup-content-wrapper {
    border-radius: 12px;
    font-family: 'Inter', sans-serif;
  }

  .leaflet-popup-content {
    margin: 13px 19px;
    line-height: 1.4;
  }
  
  .leaflet-container {
    font-family: 'Inter', sans-serif;
  }

  .contact-hero {
    padding: 10rem 1rem 3rem;
  }

  .contact-hero h1 {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 768px) {
    .contact-hero {
      padding: 7rem 1rem 2rem;
    }
    .contact-hero h1 {
      font-size: 2.25rem;
    }
    .contact-form-elite {
      padding: 2.5rem 1.5rem;
      border-radius: 24px;
    }
    .contact-form-elite h2 {
      font-size: 1.75rem;
    }
    .contact-grid-elite {
      padding-bottom: 3rem;
    }
    .map-section {
      padding: 3rem 1rem 6rem;
    }
    iframe {
      height: 350px !important;
    }
  }

  .badge-blue {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: rgba(var(--brand-blue-rgb), 0.08);
    color: var(--brand-blue);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
  }

  .contact-grid-elite {
    padding-bottom: 6rem;
  }

  .contact-form-elite {
    padding: 4rem;
    border-radius: 40px;
    background: white;
    box-shadow: 0 30px 60px rgba(0,0,0,0.05);
  }

  .contact-form-elite h2 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .form-intro {
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .elite-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .elite-form input, 
  .elite-form textarea {
    width: 100%;
    padding: 1.1rem 1.5rem;
    background: var(--bg-light);
    border: 1px solid transparent;
    border-radius: 16px;
    font-family: inherit;
    font-size: 1rem;
    transition: 0.3s;
  }

  .elite-form input:focus, 
  .elite-form textarea:focus {
    outline: none;
    border-color: var(--brand-orange);
    background: white;
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  .contact-details-elite {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-top: 1rem;
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .detail-label {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--brand-orange);
    letter-spacing: 1px;
  }

  .office-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .office-icon {
    font-size: 1.5rem;
    width: 50px;
    height: 50px;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  .office-info h3 {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
    color: var(--brand-blue);
  }

  .office-info p {
    color: var(--text-secondary);
  }

  .contact-method {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .method-icon {
    font-size: 1.2rem;
  }

  .method-text {
    display: flex;
    flex-direction: column;
  }

  .method-text .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--text-secondary);
  }

  .method-text .value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    transition: 0.3s;
  }

  .method-text .value:hover {
    color: var(--brand-orange);
  }

  /* Map Section */
  .map-section {
    padding: 6rem 1rem 10rem;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .map-wrapper {
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .grid-2 { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .form-row { grid-template-columns: 1fr; }
    .contact-hero h1 { font-size: 3rem; }
    .contact-form-elite { padding: 2.5rem; }
    .method-text .value { font-size: 1.25rem; }
  }
</style>
