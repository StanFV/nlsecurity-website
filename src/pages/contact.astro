---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { supabaseAdmin } from '../lib/supabase-admin';

const { data: teamleden } = await supabaseAdmin
  .from('team_members')
  .select('*')
  .eq('toon_contact', true)
  .order('volgorde', { ascending: true });
---

<BaseLayout title="Contact">
  <Navigation />
  
  <main class="page-contact">
    <!-- Hero -->
    <section class="contact-hero" style={`--hero-bg: url('${import.meta.env.BASE_URL}assets/images/Foto_Contact_opnemen.png')`}>
      <div class="container text-center reveal">
        <span class="badge-blue">Neem Contact Op</span>
        <h1>Zorg nu voor optimale <br/><span class="gradient-text">Beveiliging</span></h1>
        <p class="lead max-700 mx-auto">Heeft u vragen over onze diensten of wilt u een directe offerte? Onze experts staan voor u klaar om uw veiligheid naar een hoger niveau te tillen.</p>
        <div class="hero-scroll-btns">
          <a href="#ons-team" class="scroll-btn">👥 Ons team</a>
          <a href="#locaties" class="scroll-btn scroll-btn-outline">📍 Onze locaties</a>
        </div>
      </div>
    </section>

    <section class="contact-grid-elite">
      <div class="container grid grid-2">
        <!-- Form Column -->
        <div class="contact-form-elite reveal">
          <div id="form-container">
            <h2>Stuur een <span class="orange-text">bericht</span></h2>
            <p class="form-intro">Laat uw gegevens achter en wij nemen binnen 24 uur contact met u op.</p>

            <form class="elite-form" id="contact-form" action="https://formspree.io/f/xaqvpjzv" method="POST">

              <!-- Naam -->
              <div class="form-row-3">
                <input type="text" name="voornaam" placeholder="Voornaam" required />
                <input type="text" name="tussenvoegsel" placeholder="Tussenvoegsel" />
                <input type="text" name="achternaam" placeholder="Achternaam" required />
              </div>

              <!-- Bedrijf -->
              <input type="text" name="bedrijfsnaam" placeholder="Bedrijfsnaam" required />

              <!-- Contact voorkeur toggle -->
              <div class="contact-pref-label">Hoe mogen wij u bereiken?</div>
              <div class="contact-toggle">
                <button type="button" class="toggle-opt active" data-method="email">✉ E-mail</button>
                <button type="button" class="toggle-opt" data-method="phone">📞 Telefoon</button>
              </div>

              <!-- E-mail veld -->
              <div>
                <input type="email" name="email" id="input-email" placeholder="E-mailadres" required />
                <div class="field-error" id="error-email"></div>
              </div>

              <!-- Telefoon veld -->
              <div>
                <input type="tel" name="phone" id="input-phone" placeholder="Telefoonnummer (bijv. 06-12345678)" />
                <div class="field-error" id="error-phone"></div>
              </div>

              <textarea name="message" placeholder="Waarmee kunnen wij u helpen?" rows="5" required></textarea>

              <label class="privacy-label">
                <input type="checkbox" id="privacy-check" required />
                <span>
                  Ik geef toestemming aan NL Security om mijn gegevens op te slaan en te gebruiken voor het beantwoorden van mijn aanvraag. Uw gegevens worden niet gedeeld met derden.
                </span>
              </label>

              <button type="submit" id="submit-btn" class="form-submit-btn">Bericht Verzenden</button>
            </form>
          </div>

          <div id="success-message" style="display:none; text-align:center; padding:3rem 0;">
            <div style="font-size:4rem; margin-bottom:1.5rem;">✅</div>
            <h2 class="gradient-text">Bericht verzonden!</h2>
            <p style="font-size:1.1rem; color:rgba(255,255,255,0.75); line-height:1.6;">Bedankt voor uw bericht. Wij nemen binnen 24 uur contact met u op.</p>
          </div>
          <div id="error-message" style="display:none; padding:1rem; color:#fca5a5; background:rgba(220,53,69,0.2); border-radius:12px; margin-top:1rem; text-align:center;">
            Oeps! Er ging iets mis bij het verzenden. Probeer het later opnieuw.
          </div>
        </div>

        <script is:inline>
          let preferredMethod = 'email';

          // Toggle
          document.querySelectorAll('.toggle-opt').forEach(btn => {
            btn.addEventListener('click', () => {
              document.querySelectorAll('.toggle-opt').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
              preferredMethod = btn.dataset.method;
              const emailInput = document.getElementById('input-email');
              const phoneInput = document.getElementById('input-phone');
              emailInput.required = preferredMethod === 'email';
              phoneInput.required = preferredMethod === 'phone';
              clearError(emailInput, 'error-email');
              clearError(phoneInput, 'error-phone');
            });
          });

          // Validation helpers
          function validateEmail(val) {
            return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val.trim());
          }
          function validatePhone(val) {
            const cleaned = val.replace(/[\s\-\.\(\)]/g, '');
            return /^(\+31|0)[0-9]{9}$/.test(cleaned);
          }
          function setError(input, errorId, msg) {
            input.classList.add('field-invalid');
            document.getElementById(errorId).textContent = msg;
          }
          function clearError(input, errorId) {
            input.classList.remove('field-invalid');
            document.getElementById(errorId).textContent = '';
          }

          // Live validation on blur
          const emailInput = document.getElementById('input-email');
          const phoneInput = document.getElementById('input-phone');

          emailInput.addEventListener('blur', () => {
            if (emailInput.value && !validateEmail(emailInput.value))
              setError(emailInput, 'error-email', 'Voer een geldig e-mailadres in.');
            else clearError(emailInput, 'error-email');
          });
          phoneInput.addEventListener('blur', () => {
            if (phoneInput.value && !validatePhone(phoneInput.value))
              setError(phoneInput, 'error-phone', 'Voer een geldig telefoonnummer in (bijv. 06-12345678 of +31612345678).');
            else clearError(phoneInput, 'error-phone');
          });

          // Submit
          const form = document.getElementById('contact-form');
          const formContainer = document.getElementById('form-container');
          const successMessage = document.getElementById('success-message');
          const errorMessage = document.getElementById('error-message');
          const submitBtn = document.getElementById('submit-btn');

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            let valid = true;

            if (preferredMethod === 'email') {
              if (!emailInput.value || !validateEmail(emailInput.value)) {
                setError(emailInput, 'error-email', 'Voer een geldig e-mailadres in.');
                valid = false;
              } else clearError(emailInput, 'error-email');
            } else {
              if (!phoneInput.value || !validatePhone(phoneInput.value)) {
                setError(phoneInput, 'error-phone', 'Voer een geldig telefoonnummer in (bijv. 06-12345678).');
                valid = false;
              } else clearError(phoneInput, 'error-phone');
            }

            if (preferredMethod !== 'email' && emailInput.value && !validateEmail(emailInput.value)) {
              setError(emailInput, 'error-email', 'Voer een geldig e-mailadres in.');
              valid = false;
            }
            if (preferredMethod !== 'phone' && phoneInput.value && !validatePhone(phoneInput.value)) {
              setError(phoneInput, 'error-phone', 'Voer een geldig telefoonnummer in (bijv. 06-12345678).');
              valid = false;
            }

            if (!valid) return;

            submitBtn.disabled = true;
            submitBtn.innerText = 'Verzenden...';
            errorMessage.style.display = 'none';

            const formData = new FormData(form);

            // Sla op in Supabase
            try {
              await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  voornaam: formData.get('voornaam'),
                  tussenvoegsel: formData.get('tussenvoegsel'),
                  achternaam: formData.get('achternaam'),
                  bedrijfsnaam: formData.get('bedrijfsnaam'),
                  email: emailInput.value || null,
                  phone: phoneInput.value || null,
                  contact_voorkeur: preferredMethod,
                  bericht: formData.get('message'),
                  privacy_akkoord: true,
                }),
              });
            } catch (_) { /* Stille fout — formulier gaat gewoon door */ }

            // Stuur ook via Formspree voor e-mailnotificatie
            try {
              const response = await fetch(form.action, {
                method: 'POST', body: formData, headers: { 'Accept': 'application/json' }
              });
              if (response.ok) {
                formContainer.style.display = 'none';
                successMessage.style.display = 'block';
              } else {
                const data = await response.json();
                errorMessage.innerText = data.errors ? data.errors.map(err => err.message).join(', ') : 'Er ging iets mis.';
                errorMessage.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.innerText = 'Bericht Verzenden';
              }
            } catch {
              errorMessage.innerText = 'Er ging iets mis met de verbinding.';
              errorMessage.style.display = 'block';
              submitBtn.disabled = false;
              submitBtn.innerText = 'Bericht Verzenden';
            }
          });
        </script>

        <!-- Details Column -->
        <div class="contact-details-elite reveal" style="transition-delay: 0.2s">
          <div class="info-block">
            <span class="detail-label">Onze Vestigingen</span>
            <div class="office-card">
              <div class="office-icon">🏢</div>
              <div class="office-info">
                <h3>Hoofdkantoor Zoetermeer</h3>
                <p>Boerhaavelaan 31, 2713 HA Zoetermeer</p>
              </div>
            </div>
            <div class="office-card">
              <div class="office-icon">📍</div>
              <div class="office-info">
                <h3>Regio Den Haag</h3>
                <p>Stadhouderslaan 9, 2517 HV Den Haag</p>
              </div>
            </div>
          </div>

          <div class="info-block">
            <span class="detail-label">Direct Contact</span>
            <div class="contact-method">
              <span class="method-icon">📞</span>
              <div class="method-text">
                <span class="label">Telefoon</span>
                <a href="tel:0880202800" class="value">088 - 02 02 800</a>
              </div>
            </div>
            <div class="contact-method">
              <span class="method-icon">✉️</span>
              <div class="method-text">
                <span class="label">E-mail</span>
                <a href="mailto:info@nlsecurity.nl" class="value">info@nlsecurity.nl</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Team sectie -->
    {teamleden && teamleden.length > 0 && (
      <section class="team-section" id="ons-team">
        <div class="container">
          <div class="section-header text-center reveal">
            <span class="badge-orange">Ons Team</span>
            <h2>Persoonlijk <span class="orange-text">Contact</span></h2>
            <p class="section-sub">Onze medewerkers staan klaar om u te helpen.</p>
          </div>
          <div class="team-grid reveal">
            {(teamleden as any[]).map((lid) => (
              <div class="team-member-card">
                <div class="member-foto">
                  {lid.foto_url
                    ? <img src={lid.foto_url} alt={lid.naam} />
                    : <span class="member-initials">{lid.naam.split(' ').map((n: string) => n[0]).join('').slice(0,2).toUpperCase()}</span>
                  }
                </div>
                <div class="member-details">
                  <h3>{lid.naam}</h3>
                  <p class="member-func">{lid.functie}</p>
                  {lid.beschrijving && <p class="member-bio">{lid.beschrijving}</p>}
                  <div class="member-contact-links">
                    {lid.email && (
                      <a href={`mailto:${lid.email}`} class="member-link">
                        <span class="link-icon">✉</span>{lid.email}
                      </a>
                    )}
                    {lid.phone && (
                      <a href={`tel:${lid.phone.replace(/\s/g,'')}`} class="member-link">
                        <span class="link-icon">📞</span>{lid.phone}
                      </a>
                    )}
                    {lid.linkedin && (
                      <a href={lid.linkedin} target="_blank" rel="noopener" class="member-link">
                        <span class="link-icon">💼</span>LinkedIn
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Map Section -->
    <section class="map-section" id="locaties">
      <div class="container">
        <div class="section-header text-center reveal">
          <h2>Onze <span class="gradient-text">Locaties</span></h2>
          <p>Bezoek ons in Zoetermeer of Den Haag — of plan direct uw route.</p>
        </div>

        <div class="map-layout reveal">
          <!-- Locatiekaarten -->
          <div class="location-cards">
            <div class="location-card active" data-index="0">
              <div class="loc-icon">🏢</div>
              <div class="loc-info">
                <span class="loc-label">Hoofdkantoor</span>
                <h3>Zoetermeer</h3>
                <p>Boerhaavelaan 31<br/>2713 HA Zoetermeer</p>
              </div>
              <button class="route-btn" data-lat="52.0722" data-lng="4.4842" data-name="NL Security Zoetermeer, Boerhaavelaan 31">
                <span class="route-icon">↗</span> Route plannen
              </button>
            </div>

            <div class="location-card" data-index="1">
              <div class="loc-icon">📍</div>
              <div class="loc-info">
                <span class="loc-label">Regiokantoor</span>
                <h3>Den Haag</h3>
                <p>Stadhouderslaan 9<br/>2517 HV Den Haag</p>
              </div>
              <button class="route-btn" data-lat="52.0886" data-lng="4.2831" data-name="NL Security Den Haag, Stadhouderslaan 9">
                <span class="route-icon">↗</span> Route plannen
              </button>
            </div>
          </div>

          <!-- Kaart -->
          <div class="map-wrapper">
            <div id="map"></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  document.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener('click', e => {
      const target = document.querySelector(link.getAttribute('href'));
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script is:inline>
  const locations = [
    { name: "Hoofdkantoor Zoetermeer", address: "Boerhaavelaan 31, 2713 HA Zoetermeer", coords: [52.0722, 4.4842] },
    { name: "Regiokantoor Den Haag",   address: "Stadhouderslaan 9, 2517 HV Den Haag",  coords: [52.0886, 4.2831] }
  ];

  let map, markers = [], activeIndex = 0;

  document.addEventListener('DOMContentLoaded', () => {
    map = L.map('map', { zoomControl: false, scrollWheelZoom: false }).setView([52.078, 4.38], 11);

    // CartoDB Positron — schone moderne stijl
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);

    L.control.zoom({ position: 'bottomright' }).addTo(map);

    function makeIcon(active) {
      return L.divIcon({
        className: '',
        html: `<div style="
          width:${active ? 20 : 14}px;
          height:${active ? 20 : 14}px;
          background:${active ? '#FF6600' : '#002E5D'};
          border-radius:50%;
          border:3px solid white;
          box-shadow:0 4px 16px rgba(0,0,0,${active ? '0.35' : '0.2'});
          transition:all 0.3s;
        "></div>`,
        iconSize: [active ? 20 : 14, active ? 20 : 14],
        iconAnchor: [active ? 10 : 7, active ? 10 : 7]
      });
    }

    locations.forEach((loc, i) => {
      const marker = L.marker(loc.coords, { icon: makeIcon(i === 0) })
        .addTo(map)
        .bindPopup(`
          <div style="font-family:inherit;min-width:160px;">
            <strong style="color:#002E5D;font-size:0.9rem;">${loc.name}</strong>
            <br/><span style="color:#64748b;font-size:0.8rem;">${loc.address}</span>
          </div>
        `, { offset: [0, -8] });
      markers.push(marker);
    });

    // Fit both locations in view
    const group = L.featureGroup(markers);
    map.fitBounds(group.getBounds().pad(0.45));

    // Klik op locatiekaart → zoom naar marker
    document.querySelectorAll('.location-card').forEach((card, i) => {
      card.addEventListener('click', () => selectLocation(i));
    });

    function selectLocation(i) {
      activeIndex = i;
      document.querySelectorAll('.location-card').forEach((c, j) => c.classList.toggle('active', j === i));
      markers.forEach((m, j) => m.setIcon(makeIcon(j === i)));
      map.flyTo(locations[i].coords, 14, { duration: 1 });
      markers[i].openPopup();
    }

    // Route plannen
    document.querySelectorAll('.route-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const destLat = btn.dataset.lat;
        const destLng = btn.dataset.lng;
        const destName = encodeURIComponent(btn.dataset.name);

        if (navigator.geolocation) {
          btn.textContent = 'Locatie bepalen...';
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              const { latitude, longitude } = pos.coords;
              const url = `https://www.google.com/maps/dir/${latitude},${longitude}/${destLat},${destLng}`;
              window.open(url, '_blank');
              btn.innerHTML = '<span class="route-icon">↗</span> Route plannen';
            },
            () => {
              // Geen toestemming → open Google Maps met alleen bestemming
              const url = `https://www.google.com/maps/search/?api=1&query=${destLat},${destLng}`;
              window.open(url, '_blank');
              btn.innerHTML = '<span class="route-icon">↗</span> Route plannen';
            },
            { timeout: 8000 }
          );
        } else {
          const url = `https://www.google.com/maps/search/?api=1&query=${destLat},${destLng}`;
          window.open(url, '_blank');
        }
      });
    });
  });
</script>

<style>
  /* Scroll buttons in hero */
  .hero-scroll-btns {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
  .scroll-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    background: var(--brand-blue);
    color: white;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: 0.2s;
    box-shadow: 0 4px 16px rgba(0,46,93,0.25);
  }
  .scroll-btn:hover {
    background: var(--brand-orange);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255,102,0,0.3);
  }
  .scroll-btn-outline {
    background: transparent;
    border: 2px solid var(--brand-blue);
    color: var(--brand-blue);
    box-shadow: none;
  }
  .scroll-btn-outline:hover {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
    color: white;
  }

  #ons-team,
  #locaties {
    scroll-margin-top: 80px;
  }

  /* Team sectie */
  .team-section {
    padding: 3.5rem 1rem;
    background: var(--brand-blue);
    position: relative;
    overflow: hidden;
  }
  .team-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(255,102,0,0.05) 0%, transparent 70%);
    pointer-events: none;
  }
  .team-section .section-header { position: relative; z-index: 1; }
  .team-section .section-header h2 { color: white; }
  .badge-orange {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: rgba(255,102,0,0.18);
    color: var(--brand-orange);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    border: 1px solid rgba(255,102,0,0.25);
  }
  .section-sub {
    color: rgba(255,255,255,0.55);
    font-size: 1rem;
    margin-top: 0.5rem;
  }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
    position: relative;
    z-index: 1;
  }
  .team-member-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    transition: transform 0.2s, background 0.2s, box-shadow 0.2s;
  }
  .team-member-card:hover {
    transform: translateY(-4px);
    background: rgba(255,255,255,0.1);
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  }
  .member-foto {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
  }
  .member-foto img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid rgba(255,255,255,0.15);
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
  }
  .member-initials {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 800;
    border: 4px solid rgba(255,255,255,0.15);
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
  }
  .member-details { width: 100%; }
  .member-details h3 { font-size: 1.1rem; color: white; margin: 0 0 0.3rem; }
  .member-func { font-size: 0.82rem; font-weight: 700; color: var(--brand-orange); text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 0.75rem; }
  .member-bio { font-size: 0.83rem; color: rgba(255,255,255,0.5); line-height: 1.55; margin: 0 0 1rem; }
  .member-contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: center;
  }
  .member-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.65);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }
  .member-link:hover { color: var(--brand-orange); }
  .link-icon { font-size: 0.85rem; }

  @media (max-width: 900px) {
    .team-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 580px) {
    .team-grid { grid-template-columns: 1fr; }
