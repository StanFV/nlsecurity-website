---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { requireAdminAuth } from "../../lib/admin-auth";

const auth = await requireAdminAuth(Astro.cookies);
if (!auth) return Astro.redirect("/admin");
if (!auth.mfa_required) return Astro.redirect("/admin");
if (auth.aal === "aal2") return Astro.redirect("/admin");

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY;
---

<BaseLayout title="MFA Instellen">
	<Navigation />

	<main class="mfa-page">
		<section class="mfa-hero">
			<div class="container">
				<div class="mfa-container reveal">

					<!-- Stap 1: QR code scannen -->
					<div id="step-enroll">
						<div class="mfa-icon">📱</div>
						<span class="mfa-badge">MFA vereist</span>
						<h1>Authenticator <span class="orange-text">Instellen</span></h1>
						<p>Jouw beheerder heeft MFA ingeschakeld voor jouw account. Scan de QR-code met een authenticator-app zoals Google Authenticator of Authy.</p>

						<div id="qr-wrapper" class="qr-wrapper">
							<div id="qr-loading">QR-code laden...</div>
							<canvas id="qr-canvas" style="display:none;"></canvas>
						</div>

						<div class="secret-wrapper">
							<p class="secret-label">Of voer deze code handmatig in:</p>
							<code id="totp-secret" class="totp-secret">laden...</code>
						</div>

						<button id="next-btn" class="btn-glow" style="margin-top:1.5rem;">Verder →</button>
					</div>

					<!-- Stap 2: Code verifiëren -->
					<div id="step-verify" style="display:none;">
						<div class="mfa-icon">🔐</div>
						<h1>Code <span class="orange-text">Verifiëren</span></h1>
						<p>Voer de 6-cijferige code in van je authenticator-app om de instelling te bevestigen.</p>

						<input type="text" id="verify-code" inputmode="numeric" maxlength="6" placeholder="000000" autocomplete="one-time-code" />
						<button id="verify-btn" class="btn-glow" style="margin-top:1rem;">Bevestigen</button>
						<p id="verify-error" class="error-text" style="display:none;"></p>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
const initSetup = async () => {
	const { createClient } = await import("https://esm.sh/@supabase/supabase-js@2");
	const supabase = createClient(supabaseUrl, supabaseKey);

	const getCookie = (name) => {
		const match = document.cookie.match(new RegExp(`(^| )${name}=([^;]+)`));
		return match ? match[2] : null;
	};

	await supabase.auth.setSession({
		access_token: getCookie("sb-access-token"),
		refresh_token: getCookie("sb-refresh-token"),
	});

	// Enroll TOTP factor
	const { data: enrollData, error: enrollError } = await supabase.auth.mfa.enroll({ factorType: "totp" });
	if (enrollError) {
		document.getElementById("qr-loading").textContent = "Fout bij laden: " + enrollError.message;
		return;
	}

	const { id: factorId, totp } = enrollData;

	// QR code renderen via qrcode.js
	const script = document.createElement("script");
	script.src = "https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js";
	script.onload = () => {
		document.getElementById("qr-loading").style.display = "none";
		const canvas = document.getElementById("qr-canvas");
		canvas.style.display = "block";
		new QRCode(canvas, { text: totp.uri, width: 200, height: 200 });
	};
	document.head.appendChild(script);

	document.getElementById("totp-secret").textContent = totp.secret;

	// Stap 2
	document.getElementById("next-btn").onclick = () => {
		document.getElementById("step-enroll").style.display = "none";
		document.getElementById("step-verify").style.display = "block";
		document.getElementById("verify-code").focus();
	};

	const verifyInput = document.getElementById("verify-code");
	const verifyBtn = document.getElementById("verify-btn");
	const verifyError = document.getElementById("verify-error");

	verifyInput.addEventListener("input", () => {
		if (verifyInput.value.length === 6) verifyBtn.click();
	});

	verifyBtn.onclick = async () => {
		const code = verifyInput.value.trim();
		if (code.length !== 6) return;

		verifyBtn.disabled = true;
		verifyBtn.textContent = "Bevestigen...";
		verifyError.style.display = "none";

		const { data: challengeData, error: challengeError } = await supabase.auth.mfa.challenge({ factorId });
		if (challengeError) {
			verifyError.textContent = challengeError.message;
			verifyError.style.display = "block";
			verifyBtn.disabled = false;
			verifyBtn.textContent = "Bevestigen";
			return;
		}

		const { data, error } = await supabase.auth.mfa.verify({
			factorId,
			challengeId: challengeData.id,
			code,
		});

		if (error) {
			verifyError.textContent = "Ongeldige code. Controleer je authenticator-app.";
			verifyError.style.display = "block";
			verifyBtn.disabled = false;
			verifyBtn.textContent = "Bevestigen";
			verifyInput.value = "";
			verifyInput.focus();
			return;
		}

		// Sessie opslaan met AAL2
		const expirationDate = new Date();
		expirationDate.setFullYear(expirationDate.getFullYear() + 1);
		const isSecure = location.protocol === "https:" ? "; Secure" : "";
		document.cookie = `sb-access-token=${data.session.access_token}; path=/; expires=${expirationDate.toUTCString()}; SameSite=Lax${isSecure}`;
		document.cookie = `sb-refresh-token=${data.session.refresh_token}; path=/; expires=${expirationDate.toUTCString()}; SameSite=Lax${isSecure}`;

		window.location.href = "/admin";
	};
};

initSetup();
</script>

<style>
.mfa-page { padding-top: 80px; min-height: 100vh; background: var(--brand-blue); }
.mfa-hero { padding: 8rem 0; }
.mfa-container {
	max-width: 460px;
	margin: 0 auto;
	text-align: center;
	background: white;
	border-radius: 28px;
	padding: 3rem 2.5rem;
	box-shadow: 0 24px 60px rgba(0,0,0,0.25);
}
.mfa-icon { font-size: 3rem; margin-bottom: 1rem; }
.mfa-badge {
	display: inline-block;
	background: rgba(0,46,93,0.08);
	color: var(--brand-blue);
	padding: 0.3rem 0.9rem;
	border-radius: 999px;
	font-size: 0.72rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	margin-bottom: 0.75rem;
}
h1 { font-size: 2rem; margin: 0.5rem 0 1rem; }
p { color: var(--text-secondary); margin-bottom: 1.5rem; font-size: 0.95rem; }
.qr-wrapper { display: flex; justify-content: center; margin: 1.5rem 0; }
#qr-canvas { border-radius: 12px; }
.secret-wrapper { margin: 1rem 0; }
.secret-label { font-size: 0.8rem; color: #94a3b8; margin-bottom: 0.5rem; }
.totp-secret {
	display: block;
	background: #f1f5f9;
	padding: 0.75rem 1rem;
	border-radius: 10px;
	font-size: 0.85rem;
	letter-spacing: 0.1em;
	word-break: break-all;
}
#verify-code {
	width: 100%;
	padding: 1rem;
	text-align: center;
	font-size: 2rem;
	letter-spacing: 0.4em;
	border-radius: 14px;
	border: 2px solid rgba(0,0,0,0.1);
	background: #f8fafc;
	font-family: monospace;
	transition: border-color 0.2s;
}
#verify-code:focus { outline: none; border-color: var(--brand-orange); background: white; }
.btn-glow { width: 100%; }
.error-text { color: #dc2626; font-size: 0.875rem; margin-top: 0.75rem; }
</style>
