---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { requireAdminAuth } from "../../lib/admin-auth";

const auth = await requireAdminAuth(Astro.cookies);
if (!auth) return Astro.redirect("/admin");
if (!auth.mfa_required) return Astro.redirect("/admin");
if (auth.aal === "aal2") return Astro.redirect("/admin");

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY;
---

<BaseLayout title="MFA Instellen">
	<Navigation />

	<main class="mfa-page">
		<section class="mfa-hero">
			<div class="container">
				<div class="mfa-container reveal">

					<!-- Stap 1: QR code scannen -->
					<div id="step-enroll">
						<div class="mfa-icon">📱</div>
						<span class="mfa-badge">MFA vereist</span>
						<h1>Authenticator <span class="orange-text">Instellen</span></h1>
						<p>Jouw beheerder heeft MFA ingeschakeld voor jouw account. Scan de QR-code met een authenticator-app zoals Google Authenticator of Authy.</p>

						<div id="qr-wrapper" class="qr-wrapper">
							<div id="qr-loading">QR-code laden...</div>
							<div id="qr-canvas" style="display:none;"></div>
						</div>

						<div class="secret-wrapper">
							<p class="secret-label">Of voer deze code handmatig in:</p>
							<code id="totp-secret" class="totp-secret">laden...</code>
						</div>

						<button id="next-btn" class="btn-glow" style="margin-top:1.5rem;">Verder →</button>
					</div>

					<!-- Stap 2: Code verifiëren -->
					<div id="step-verify" style="display:none;">
						<div class="mfa-icon">🔐</div>
						<h1>Code <span class="orange-text">Verifiëren</span></h1>
						<p>Voer de 6-cijferige code in van je authenticator-app om de instelling te bevestigen.</p>

						<input type="text" id="verify-code" inputmode="numeric" maxlength="6" placeholder="000000" autocomplete="one-time-code" />
						<button id="verify-btn" class="btn-glow" style="margin-top:1rem;">BEVESTIGEN</button>
						<p id="verify-error" class="error-text" style="display:none;"></p>
						
						<div class="debug-log" id="debug-log">
							<p>Systeem Status:</p>
							<ul id="log-list">
								<li>Wachten op invoer...</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
// Globale status
let currentFactorId = null;
let supabase = null;

function addLog(msg) {
	const list = document.getElementById("log-list");
	const li = document.createElement("li");
	li.textContent = "> " + msg;
	list.appendChild(li);
	console.log("MFA LOG:", msg);
}

async function initSupabase() {
	try {
		addLog("Verbinding maken met beveiligingsserver...");
		supabase = window.supabase.createClient(supabaseUrl, supabaseKey);

		const getCookie = (name) => {
			const match = document.cookie.match(new RegExp(`(^| )${name}=([^;]+)`));
			return match ? match[2] : null;
		};

		const accessToken = getCookie("sb-access-token");
		const refreshToken = getCookie("sb-refresh-token");

		if (accessToken && refreshToken) {
			await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
			addLog("Sessie hersteld.");
		}

		startEnroll();
	} catch (err) {
		addLog("Fout bij initialisatie: " + err.message);
	}
}

async function startEnroll() {
	try {
		addLog("MFA enrollment starten...");
		const { data: factors } = await supabase.auth.mfa.listFactors();
		const unverified = factors?.totp?.find(f => f.status === "unverified");
		if (unverified) {
			addLog("Oude poging opruimen...");
			await supabase.auth.mfa.unenroll({ factorId: unverified.id });
		}

		const { data, error } = await supabase.auth.mfa.enroll({ factorType: "totp" });
		if (error) throw error;

		currentFactorId = data.id;
		document.getElementById("totp-secret").textContent = data.totp.secret;

		const qrScript = document.createElement("script");
		qrScript.src = "https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js";
		qrScript.onload = () => {
			document.getElementById("qr-loading").style.display = "none";
			const canvas = document.getElementById("qr-canvas");
			canvas.style.display = "block";
			canvas.innerHTML = "";
			new QRCode(canvas, { text: data.totp.uri, width: 200, height: 200 });
			addLog("QR Code gereed.");
		};
		document.head.appendChild(qrScript);
	} catch (err) {
		addLog("FOUT: " + err.message);
		alert("Fout bij laden MFA: " + err.message);
	}
}

// Navigatie
document.getElementById("next-btn").onclick = () => {
	document.getElementById("step-enroll").style.display = "none";
	document.getElementById("step-verify").style.display = "block";
	document.getElementById("verify-code").focus();
};

// Verificatie
const verifyBtn = document.getElementById("verify-btn");
const verifyInput = document.getElementById("verify-code");
const verifyError = document.getElementById("verify-error");

verifyBtn.onclick = async () => {
	const code = verifyInput.value.trim();
	if (code.length !== 6) return;

	addLog("Verifiëren van code: " + code);
	verifyBtn.disabled = true;
	verifyBtn.textContent = "BEZIG...";
	
	try {
		if (!currentFactorId) throw new Error("Geen factor ID (ververs pagina)");

		addLog("Aanvragen challenge...");
		const { data: challenge, error: cErr } = await supabase.auth.mfa.challenge({ factorId: currentFactorId });
		if (cErr) throw cErr;

		addLog("Challenge ontvangen, verifiëren bij server...");
		const { data: verify, error: vErr } = await supabase.auth.mfa.verify({
			factorId: currentFactorId,
			challengeId: challenge.id,
			code
		});
		if (vErr) throw vErr;

		addLog("Succes! Sessie bijwerken...");
		const exp = new Date();
		exp.setFullYear(exp.getFullYear() + 1);
		const secure = location.protocol === "https:" ? "; Secure" : "";
		document.cookie = `sb-access-token=${verify.session.access_token}; path=/; expires=${exp.toUTCString()}; SameSite=Lax${secure}`;
		document.cookie = `sb-refresh-token=${verify.session.refresh_token}; path=/; expires=${exp.toUTCString()}; SameSite=Lax${secure}`;

		addLog("Doorsturen naar dashboard...");
		window.location.assign("/admin");
	} catch (err) {
		addLog("FOUT: " + err.message);
		alert("MFA Fout: " + err.message);
		verifyError.textContent = err.message;
		verifyError.style.display = "block";
		verifyBtn.disabled = false;
		verifyBtn.textContent = "BEVESTIGEN";
	}
};

verifyInput.addEventListener("input", () => {
	if (verifyInput.value.length === 6) verifyBtn.click();
});

// Wachten op CDN script
window.onload = () => {
	if (window.supabase) initSupabase();
	else {
		addLog("Wachten op bibliotheek...");
		let attempts = 0;
		const check = setInterval(() => {
			attempts++;
			if (window.supabase) {
				clearInterval(check);
				initSupabase();
			} else if (attempts > 50) {
				clearInterval(check);
				addLog("Fout: Kon bibliotheek niet laden.");
			}
		}, 100);
	}
};
</script>

<style>
.mfa-page { padding-top: 80px; min-height: 100vh; background: var(--brand-blue); }
.mfa-hero { padding: 8rem 0; }
.mfa-container {
	max-width: 460px;
	margin: 0 auto;
	text-align: center;
	background: white;
	border-radius: 28px;
	padding: 3rem 2.5rem;
	box-shadow: 0 24px 60px rgba(0,0,0,0.25);
}
.mfa-icon { font-size: 3rem; margin-bottom: 1rem; }
.mfa-badge {
	display: inline-block;
	background: rgba(0,46,93,0.08);
	color: var(--brand-blue);
	padding: 0.3rem 0.9rem;
	border-radius: 999px;
	font-size: 0.72rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	margin-bottom: 0.75rem;
}
h1 { font-size: 2rem; margin: 0.5rem 0 1rem; }
p { color: var(--text-secondary); margin-bottom: 1.5rem; font-size: 0.95rem; }
.qr-wrapper { display: flex; justify-content: center; margin: 1.5rem 0; }
#qr-canvas { border-radius: 12px; }
.secret-wrapper { margin: 1rem 0; }
.secret-label { font-size: 0.8rem; color: #94a3b8; margin-bottom: 0.5rem; }
.totp-secret {
	display: block;
	background: #f1f5f9;
	padding: 0.75rem 1rem;
	border-radius: 10px;
	font-size: 0.85rem;
	letter-spacing: 0.1em;
	word-break: break-all;
}
#verify-code {
	width: 100%;
	padding: 1rem;
	text-align: center;
	font-size: 2rem;
	letter-spacing: 0.4em;
	border-radius: 14px;
	border: 2px solid rgba(0,0,0,0.1);
	background: #f8fafc;
	font-family: monospace;
	transition: border-color 0.2s;
}
#verify-code:focus { outline: none; border-color: var(--brand-orange); background: white; }
.btn-glow { width: 100%; }
.error-text { color: #dc2626; font-size: 0.875rem; margin-top: 0.75rem; }

.debug-log {
	margin-top: 2rem;
	text-align: left;
	background: #f1f5f9;
	padding: 1rem;
	border-radius: 12px;
	font-family: monospace;
	font-size: 0.75rem;
}
.debug-log p { margin-bottom: 0.5rem; font-weight: 700; color: #64748b; }
.debug-log ul { list-style: none; padding: 0; margin: 0; }
.debug-log li { color: #94a3b8; margin-bottom: 0.2rem; }
</style>
