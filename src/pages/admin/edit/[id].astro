---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
import { supabase } from "../../../lib/supabase";
import { requireAdminAuth } from "../../../lib/admin-auth";
import { supabaseAdmin } from "../../../lib/supabase-admin";

const { id } = Astro.params;

const auth = await requireAdminAuth(Astro.cookies);
if (!auth) return Astro.redirect("/admin");

if (auth.mfa_required && auth.aal !== "aal2") {
	const { data: adminUser } = await supabaseAdmin.auth.admin.getUserById(auth.user.id);
	const hasFactors = ((adminUser?.user as any)?.factors ?? []).length > 0;
	return Astro.redirect(hasFactors ? "/admin/mfa" : "/admin/mfa-setup");
}

// Haal de specifieke vacature op
const { data: vacancy, error: fetchError } = await supabase
	.from('vacancies')
	.select('*')
	.eq('id', id)
	.single();


if (fetchError || !vacancy) {
	return Astro.redirect("/admin?error=notfound");
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY;
---

<BaseLayout title={`Bewerk: ${vacancy.title}`}>
	<Navigation />

	<main class="admin-page">
		<section class="admin-hero">
			<div class="container">
				<div class="page-header reveal">
					<a href="/admin/vacatures" class="back-link">← Terug naar Vacatures</a>
					<h1>Bewerk <span class="orange-text">Vacature</span></h1>
				</div>
				<div class="form-card reveal">
					<form id="edit-vacancy-form">
						<input type="hidden" id="v-id" value={vacancy.id} />
						<div class="form-group">
							<label>Functietitel</label>
							<input type="text" id="v-title" value={vacancy.title} required />
						</div>
						<div class="form-row">
							<div class="form-group">
								<label>Type</label>
								<select id="v-type" required>
									<option value="Beveiliging" selected={vacancy.type === 'Beveiliging'}>Beveiliging</option>
									<option value="Hospitality" selected={vacancy.type === 'Hospitality'}>Hospitality</option>
									<option value="Kantoor" selected={vacancy.type === 'Kantoor'}>Kantoor</option>
									<option value="Logistiek" selected={vacancy.type === 'Logistiek'}>Logistiek</option>
								</select>
							</div>
							<div class="form-group">
								<label>Locatie / Uren</label>
								<input type="text" id="v-loc" value={vacancy.location} />
							</div>
						</div>
						<div class="form-group">
							<label>Beschrijving</label>
							<textarea id="v-desc" rows="4" required>{vacancy.description}</textarea>
						</div>
						<div class="form-group">
							<label>Eisen (één per regel)</label>
							<textarea id="v-req" rows="5" required>{vacancy.requirements ? vacancy.requirements.join('\n') : ''}</textarea>
						</div>
						<div class="form-group">
							<label>Wat wij bieden (één per regel)</label>
							<textarea id="v-offer" rows="5" required>{vacancy.offer ? vacancy.offer.join('\n') : ''}</textarea>
						</div>
						<div class="form-actions">
							<a href="/admin/vacatures" class="btn-outline">Annuleren</a>
							<button type="submit" id="save-btn" class="btn-glow">Wijzigingen Opslaan</button>
						</div>
					</form>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
	const initEditForm = () => {
		const form = document.getElementById("edit-vacancy-form");
		const btn = document.getElementById("save-btn");

		if (form && btn) {
			form.onsubmit = async (e) => {
				e.preventDefault();
				btn.disabled = true;
				btn.textContent = "Bezig met opslaan...";
				
				const id = document.getElementById("v-id").value;
				const title = document.getElementById("v-title").value;
				const type = document.getElementById("v-type").value;
				const location = document.getElementById("v-loc").value;
				const description = document.getElementById("v-desc").value;
				const requirements = document.getElementById("v-req").value.split('\n').filter(line => line.trim() !== '');
				const offer = document.getElementById("v-offer").value.split('\n').filter(line => line.trim() !== '');

				try {
					const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
					const supabase = createClient(supabaseUrl, supabaseKey);

					const { error } = await supabase
						.from('vacancies')
						.update({
							title,
							type,
							location,
							description,
							requirements,
							offer
						})
						.eq('id', id);

					if (error) {
						alert("Fout bij opslaan: " + error.message);
						btn.disabled = false;
						btn.textContent = "Wijzigingen Opslaan";
					} else {
						alert("Vacature succesvol bijgewerkt!");
						window.location.href = "/admin/vacatures";
					}
				} catch (err) {
					alert("Er is een onverwachte fout opgetreden: " + err.message);
					btn.disabled = false;
					btn.textContent = "Wijzigingen Opslaan";
				}
			};
		}
	};

	initEditForm();
</script>

<style>
	.admin-page { padding-top: 80px; min-height: 100vh; background: var(--brand-blue); }
	.admin-hero { padding: 5rem 0 7rem; }
	.page-header { margin-bottom: 2rem; }
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: rgba(255,255,255,0.6);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
		transition: color 0.2s;
	}
	.back-link:hover { color: white; }
	.page-header h1 { color: white; font-size: 2.2rem; margin: 0.4rem 0 0; }
	.form-card {
		max-width: 800px;
		margin: 0 auto;
		padding: 3rem;
		background: white;
		border-radius: 28px;
		box-shadow: 0 16px 60px rgba(0,0,0,0.2);
	}
	.form-group { margin-bottom: 1.5rem; }
	.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
	label {
		display: block;
		margin-bottom: 0.5rem;
		font-weight: 700;
		color: var(--brand-blue);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	input, select, textarea {
		width: 100%;
		padding: 0.9rem 1rem;
		border-radius: 10px;
		border: 1.5px solid rgba(0,0,0,0.1);
		font-family: inherit;
		font-size: 0.95rem;
		background: #f8fafc;
		transition: border-color 0.2s, background 0.2s;
	}
	input:focus, select:focus, textarea:focus {
		outline: none;
		border-color: var(--brand-orange);
		background: white;
	}
	.form-actions { margin-top: 2.5rem; display: flex; justify-content: flex-end; gap: 1rem; }
	button:disabled { opacity: 0.6; cursor: not-allowed; }
	@media (max-width: 600px) {
		.form-row { grid-template-columns: 1fr; }
		.form-card { padding: 2rem 1.5rem; }
	}
</style>
