---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { requireAdminAuth } from "../../lib/admin-auth";
import { supabaseAdmin } from "../../lib/supabase-admin";

const auth = await requireAdminAuth(Astro.cookies);
if (!auth) return Astro.redirect("/admin");

if (auth.mfa_required && auth.aal !== "aal2") {
	const { data: adminUser } = await supabaseAdmin.auth.admin.getUserById(auth.user.id);
	const hasFactors = ((adminUser?.user as any)?.factors ?? []).length > 0;
	return Astro.redirect(hasFactors ? "/admin/mfa" : "/admin/mfa-setup");
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY;
---

<BaseLayout title="Nieuwe Vacature">
	<Navigation />

	<main class="admin-page">
		<section class="admin-hero">
			<div class="container">
				<div class="page-header reveal">
					<a href="/admin/vacatures" class="back-link">← Terug naar Vacatures</a>
					<h1>Nieuwe <span class="orange-text">Vacature</span></h1>
				</div>
				<div class="form-card reveal">
					<form id="vacancy-form">
						<div class="form-group">
							<label>Functietitel</label>
							<input type="text" name="title" id="v-title" placeholder="bijv. Professionele Beveiliger" required />
						</div>
						<div class="form-row">
							<div class="form-group">
								<label>Type</label>
								<select name="type" id="v-type" required>
									<option value="Beveiliging">Beveiliging</option>
									<option value="Hospitality">Hospitality</option>
									<option value="Kantoor">Kantoor</option>
									<option value="Logistiek">Logistiek</option>
								</select>
							</div>
							<div class="form-group">
								<label>Locatie / Uren</label>
								<input type="text" name="location" id="v-loc" placeholder="bijv. Regio Zuid-Holland of 40 uur" />
							</div>
						</div>
						<div class="form-group">
							<label>Beschrijving</label>
							<textarea name="description" id="v-desc" rows="4" placeholder="Korte introductie over de functie..." required></textarea>
						</div>
						<div class="form-group">
							<label>Eisen (één per regel)</label>
							<textarea name="requirements" id="v-req" rows="5" placeholder="Diploma Beveiliger 2&#10;Minimaal 2 jaar ervaring..." required></textarea>
						</div>
						<div class="form-group">
							<label>Wat wij bieden (één per regel)</label>
							<textarea name="offer" id="v-offer" rows="5" placeholder="Salaris conform CAO&#10;Pensioenregeling..." required></textarea>
						</div>
						<div class="form-actions">
							<a href="/admin/vacatures" class="btn-outline">Annuleren</a>
							<button type="submit" id="submit-btn" class="btn-glow">Vacature Publiceren</button>
						</div>
					</form>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
	const initForm = () => {
		const form = document.getElementById("vacancy-form");
		const btn = document.getElementById("submit-btn");

		if (form && btn) {
			form.onsubmit = async (e) => {
				e.preventDefault();
				btn.disabled = true;
				btn.textContent = "Bezig met publiceren...";
				
				const title = document.getElementById("v-title").value;
				const type = document.getElementById("v-type").value;
				const location = document.getElementById("v-loc").value;
				const description = document.getElementById("v-desc").value;
				const requirements = document.getElementById("v-req").value.split('\n').filter(line => line.trim() !== '');
				const offer = document.getElementById("v-offer").value.split('\n').filter(line => line.trim() !== '');

				try {
					const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
					const supabase = createClient(supabaseUrl, supabaseKey);

					const { error } = await supabase.from('vacancies').insert([{
						title,
						type,
						location,
						description,
						requirements,
						offer
					}]);

					if (error) {
						alert("Fout bij opslaan: " + error.message);
						btn.disabled = false;
						btn.textContent = "Vacature Publiceren";
					} else {
						alert("Vacature succesvol geplaatst!");
						window.location.href = "/admin/vacatures";
					}
				} catch (err) {
					alert("Er is een onverwachte fout opgetreden: " + err.message);
					btn.disabled = false;
					btn.textContent = "Vacature Publiceren";
				}
			};
		}
	};

	initForm();
</script>

<style>
	.admin-page { padding-top: 80px; min-height: 100vh; background: var(--brand-blue); }
	.admin-hero { padding: 5rem 0 7rem; }
	.page-header { margin-bottom: 2rem; }
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: rgba(255,255,255,0.6);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
		transition: color 0.2s;
	}
	.back-link:hover { color: white; }
	.page-header h1 { color: white; font-size: 2.2rem; margin: 0.4rem 0 0; }
	.form-card {
		max-width: 800px;
		margin: 0 auto;
		padding: 3rem;
		background: white;
		border-radius: 28px;
		box-shadow: 0 16px 60px rgba(0,0,0,0.2);
	}
	.form-group { margin-bottom: 1.5rem; }
	.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
	label {
		display: block;
		margin-bottom: 0.5rem;
		font-weight: 700;
		color: var(--brand-blue);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	input, select, textarea {
		width: 100%;
		padding: 0.9rem 1rem;
		border-radius: 10px;
		border: 1.5px solid rgba(0,0,0,0.1);
		font-family: inherit;
		font-size: 0.95rem;
		background: #f8fafc;
		transition: border-color 0.2s, background 0.2s;
	}
	input:focus, select:focus, textarea:focus {
		outline: none;
		border-color: var(--brand-orange);
		background: white;
	}
	.form-actions { margin-top: 2.5rem; display: flex; justify-content: flex-end; gap: 1rem; }
	button:disabled { opacity: 0.6; cursor: not-allowed; }
	@media (max-width: 600px) {
		.form-row { grid-template-columns: 1fr; }
		.form-card { padding: 2rem 1.5rem; }
	}
</style>
