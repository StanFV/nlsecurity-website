---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { requireAdminAuth } from "../../lib/admin-auth";
import { supabaseAdmin } from "../../lib/supabase-admin";

const auth = await requireAdminAuth(Astro.cookies, true);
if (!auth) return Astro.redirect("/admin");

if (auth.mfa_required && auth.aal !== "aal2") {
	const { data: adminUser } = await supabaseAdmin.auth.admin.getUserById(auth.user.id);
	const hasFactors = ((adminUser?.user as any)?.factors ?? []).length > 0;
	return Astro.redirect(hasFactors ? "/admin/mfa" : "/admin/mfa-setup");
}

const { data: authUsers } = await supabaseAdmin.auth.admin.listUsers();

// listUsers() geeft geen factors terug — haal elke gebruiker individueel op
const users = await Promise.all(
	(authUsers?.users ?? []).map(async (u) => {
		const { data: detail } = await supabaseAdmin.auth.admin.getUserById(u.id);
		const factors: any[] = (detail?.user as any)?.factors ?? [];
		const verifiedFactor = factors.find((f) => f.status === "verified");
		return {
			id: u.id,
			email: u.email ?? "",
			created_at: u.created_at,
			last_sign_in_at: u.last_sign_in_at,
			role: u.app_metadata?.role ?? "admin",
			mfa_required: u.app_metadata?.mfa_required ?? false,
			mfa_enrolled: !!verifiedFactor,
			mfa_enrolled_at: verifiedFactor?.created_at ?? null,
			is_self: u.id === auth.user.id,
		};
	})
);
---

<BaseLayout title="Medewerkers Beheer">
	<Navigation />

	<main class="admin-page">
		<section class="admin-hero">
			<div class="container">

				<!-- Paginakop -->
				<div class="page-header reveal">
					<div>
						<a href="/admin" class="back-link">← Terug naar Dashboard</a>
						<span class="page-badge">Gebruikersbeheer</span>
						<h1>Medewerkers <span class="orange-text">Beheer</span></h1>
						<p>Sla wijzigingen op voordat je de pagina verlaat.</p>
					</div>
					<button id="invite-btn" class="btn-glow">+ Medewerker Uitnodigen</button>
				</div>

				<!-- Uitnodigingsmodal -->
				<div id="invite-modal" class="modal-overlay" style="display:none;">
					<div class="modal-card">
						<h2>Medewerker <span class="orange-text">Uitnodigen</span></h2>
						<p>De medewerker ontvangt een uitnodigingsmail om een wachtwoord in te stellen.</p>
						<div class="form-group">
							<label>E-mailadres</label>
							<input type="email" id="invite-email" placeholder="naam@domein.nl" />
						</div>
						<div class="form-group">
							<label>Rol</label>
							<select id="invite-role">
								<option value="admin">Admin — toegang tot vacatures beheer</option>
								<option value="super_admin">Super Admin — volledige toegang incl. gebruikersbeheer</option>
							</select>
						</div>
						<div class="form-group">
							<label class="checkbox-label">
								<input type="checkbox" id="invite-mfa" checked />
								<span class="checkbox-text">
									<strong>MFA verplichten</strong>
									<small>Medewerker moet authenticator-app instellen bij eerste login</small>
								</span>
							</label>
						</div>
						<p id="invite-error" class="error-text" style="display:none;"></p>
						<div class="modal-actions">
							<button id="invite-cancel" class="btn-outline">Annuleren</button>
							<button id="invite-submit" class="btn-glow">Uitnodiging Versturen</button>
						</div>
					</div>
				</div>

				<!-- Gebruikerstabel -->
				<div class="users-card reveal">
					<div class="table-header">
						<span>Medewerker</span>
						<span>Rol</span>
						<span>MFA Status</span>
						<span>Laatste login</span>
						<span>Acties</span>
					</div>

					{users.map((user) => (
						<div
							class="user-row"
							data-id={user.id}
							data-orig-role={user.role}
							data-self={user.is_self ? "true" : "false"}
						>
							<div class="user-info">
								<div class="user-avatar">{user.email.charAt(0).toUpperCase()}</div>
								<div>
									<p class="user-email">{user.email}</p>
									{user.is_self && <span class="self-badge">Jij</span>}
								</div>
							</div>

							<div class="role-cell">
								<select class="role-select" data-id={user.id} disabled={user.is_self}>
									<option value="admin" selected={user.role === "admin"}>Admin</option>
									<option value="super_admin" selected={user.role === "super_admin"}>Super Admin</option>
								</select>
							</div>

							<div class="mfa-cell">
								<div class="mfa-status-wrapper">
									{user.mfa_enrolled ? (
										<>
											<span class="mfa-status enrolled">✅ Actief</span>
											{user.mfa_enrolled_at && (
												<span class="mfa-date">
													Ingesteld op {new Date(user.mfa_enrolled_at).toLocaleDateString("nl-NL", { day: "numeric", month: "short", year: "numeric" })}
												</span>
											)}
											<div class="mfa-btn-row">
												{!user.is_self && (
													<button class="btn-mfa-reset" data-id={user.id} data-email={user.email} title="Verwijdert de huidige authenticator-koppeling. MFA blijft vereist — medewerker moet bij de volgende login een nieuwe app koppelen.">
														Opnieuw koppelen
													</button>
												)}
												<button class="btn-mfa-disable" data-id={user.id} data-email={user.email} title="Schakelt MFA volledig uit voor deze medewerker. De medewerker kan daarna inloggen zonder authenticator-code.">
													Uitschakelen
												</button>
											</div>
										</>
									) : user.mfa_required ? (
										<>
											<span class="mfa-status pending">⚠️ Vereist, niet ingesteld</span>
											<div class="mfa-btn-row">
												<button class="btn-mfa-setup" data-id={user.id} data-email={user.email} title="MFA setup-mail sturen">
													Setup sturen
												</button>
												<button class="btn-mfa-disable" data-id={user.id} data-email={user.email} title="MFA vereiste uitschakelen">
													Uitschakelen
												</button>
											</div>
										</>
									) : (
										<>
											<span class="mfa-status not-enrolled">— Niet ingesteld</span>
											<button class="btn-mfa-enable" data-id={user.id} data-email={user.email} title="MFA verplichten voor deze medewerker">
												Inschakelen
											</button>
										</>
									)}
								</div>
							</div>

							<div class="last-login">
								{user.last_sign_in_at
									? new Date(user.last_sign_in_at).toLocaleDateString("nl-NL")
									: "Nog nooit"}
							</div>

							<div class="user-actions">
								<button class="btn-action btn-reset" data-id={user.id} data-email={user.email} title="Wachtwoord reset sturen">
									Reset
								</button>
								{!user.is_self && (
									<button class="btn-action btn-del" data-id={user.id} data-email={user.email} title="Verwijder medewerker">
										Verwijder
									</button>
								)}
							</div>
						</div>
					))}
				</div>

				<!-- Rol uitleg -->
				<div class="roles-card reveal">
					<h3>Rol omschrijvingen</h3>
					<div class="roles-grid">
						<div class="role-info-card">
							<span class="role-badge admin-badge-tag">Admin</span>
							<ul>
								<li>✓ Inloggen op de admin omgeving</li>
								<li>✓ Vacatures aanmaken, bewerken en verwijderen</li>
								<li>✗ Gebruikersbeheer</li>
								<li>✗ Rollen aanpassen</li>
							</ul>
						</div>
						<div class="role-info-card">
							<span class="role-badge super-badge-tag">Super Admin</span>
							<ul>
								<li>✓ Alles wat Admin kan</li>
								<li>✓ Medewerkers uitnodigen en verwijderen</li>
								<li>✓ Rollen en MFA beheren</li>
								<li>✓ Wachtwoord resets versturen</li>
							</ul>
						</div>
					</div>
				</div>

			</div>
		</section>
	</main>

	<!-- Vaste opslaan-balk (verschijnt bij wijzigingen) -->
	<div id="save-bar" class="save-bar" style="display:none;">
		<div class="save-bar-inner">
			<p id="save-bar-msg">Je hebt <strong id="change-count">0</strong> onopgeslagen wijziging(en).</p>
			<div class="save-bar-actions">
				<button id="cancel-btn" class="btn-outline-white">Annuleren</button>
				<button id="save-btn" class="btn-glow">Wijzigingen Opslaan</button>
			</div>
		</div>
	</div>

	<Footer />
</BaseLayout>

<script is:inline>
const BASE = "/api/admin/users";

// Bijhouden van wijzigingen: { userId: { role? } }
const pending = {};

function countChanges() {
	return Object.values(pending).filter(v => Object.keys(v).length > 0).length;
}

function updateSaveBar() {
	const bar = document.getElementById("save-bar");
	const count = countChanges();
	if (count > 0) {
		bar.style.display = "flex";
		document.getElementById("change-count").textContent = count;
	} else {
		bar.style.display = "none";
	}
}

function markRowPending(id) {
	const row = document.querySelector(`.user-row[data-id="${id}"]`);
	if (row) row.classList.add("pending");
}

function unmarkRowPending(id) {
	const row = document.querySelector(`.user-row[data-id="${id}"]`);
	if (row) row.classList.remove("pending");
}

// --- Rol wijzigen (alleen markeren, nog niet opslaan) ---
document.querySelectorAll(".role-select").forEach((select) => {
	select.addEventListener("change", (e) => {
		const id = e.target.dataset.id;
		const origRole = document.querySelector(`.user-row[data-id="${id}"]`).dataset.origRole;
		if (!pending[id]) pending[id] = {};
		if (e.target.value !== origRole) {
			pending[id].role = e.target.value;
			markRowPending(id);
		} else {
			delete pending[id].role;
			if (Object.keys(pending[id]).length === 0) unmarkRowPending(id);
		}
		updateSaveBar();
	});
});

// --- Annuleren: zet alles terug naar origineel ---
document.getElementById("cancel-btn").onclick = () => {
	document.querySelectorAll(".user-row").forEach((row) => {
		const id = row.dataset.id;
		const origRole = row.dataset.origRole;

		const roleSelect = row.querySelector(".role-select");
		if (roleSelect) roleSelect.value = origRole;

		row.classList.remove("pending");
		delete pending[id];
	});
	updateSaveBar();
};

// --- Opslaan: verwerk alle pending wijzigingen ---
document.getElementById("save-btn").onclick = async () => {
	const btn = document.getElementById("save-btn");
	btn.disabled = true;
	btn.textContent = "Bezig met opslaan...";

	const ids = Object.keys(pending).filter(id => Object.keys(pending[id]).length > 0);
	let failed = 0;

	for (const id of ids) {
		const res = await fetch(`${BASE}/${id}`, {
			method: "PATCH",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify(pending[id]),
		});
		if (res.ok) {
			// Bijwerken originals in DOM
			const row = document.querySelector(`.user-row[data-id="${id}"]`);
			if (pending[id].role !== undefined) row.dataset.origRole = pending[id].role;
			delete pending[id];
			unmarkRowPending(id);
		} else {
			failed++;
		}
	}

	btn.disabled = false;
	btn.textContent = "Wijzigingen Opslaan";
	updateSaveBar();

	if (failed > 0) {
		alert(`${failed} wijziging(en) konden niet worden opgeslagen. Probeer het opnieuw.`);
	}
};

// --- Uitnodigingsmodal ---
document.getElementById("invite-btn").onclick = () => {
	document.getElementById("invite-modal").style.display = "flex";
};
document.getElementById("invite-cancel").onclick = () => {
	document.getElementById("invite-modal").style.display = "none";
};
document.getElementById("invite-submit").onclick = async () => {
	const email = document.getElementById("invite-email").value.trim();
	const role = document.getElementById("invite-role").value;
	const mfa_required = document.getElementById("invite-mfa").checked;
	const errEl = document.getElementById("invite-error");
	errEl.style.display = "none";

	const res = await fetch(BASE, {
		method: "POST",
		headers: { "Content-Type": "application/json" },
		body: JSON.stringify({ email, role, mfa_required }),
	});
	const data = await res.json();
	if (!res.ok) {
		errEl.textContent = data.error;
		errEl.style.display = "block";
		return;
	}
	document.getElementById("invite-modal").style.display = "none";
	alert(`Uitnodiging verstuurd naar ${email}${mfa_required ? " (MFA vereist)" : ""}`);
	window.location.reload();
};

// --- MFA Uitschakelen (mfa_required=false + factoren verwijderen) ---
document.querySelectorAll(".btn-mfa-disable").forEach((btn) => {
	btn.onclick = async () => {
		const { id, email } = btn.dataset;
		if (!confirm(`MFA volledig uitschakelen voor ${email}?\n\nDe medewerker hoeft bij de volgende login geen authenticator-code meer in te voeren.`)) return;
		btn.disabled = true;
		btn.textContent = "...";

		try {
			// Verwijder eerst de factoren
			const resetRes = await fetch(`${BASE}/${id}/mfa-reset`, { method: "POST" });
			if (!resetRes.ok) {
				const resetData = await resetRes.json();
				throw new Error(resetData.error || "Fout bij verwijderen MFA-factor");
			}

			// Zet mfa_required op false
			const patchRes = await fetch(`${BASE}/${id}`, {
				method: "PATCH",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ mfa_required: false }),
			});
			if (!patchRes.ok) {
				const patchData = await patchRes.json();
				throw new Error(patchData.error || "Fout bij uitschakelen MFA-vereiste");
			}

			alert(`MFA uitgeschakeld voor ${email}`);
			window.location.reload();
		} catch (err) {
			alert(`Fout: ${err.message}`);
			btn.disabled = false;
			btn.textContent = "Uitschakelen";
		}
	};
});

// --- MFA Inschakelen (mfa_required=true, geen factor-reset nodig) ---
document.querySelectorAll(".btn-mfa-enable").forEach((btn) => {
	btn.onclick = async () => {
		const { id, email } = btn.dataset;
		if (!confirm(`MFA verplichten voor ${email}?\n\nDe medewerker wordt bij de volgende login gevraagd een authenticator-app in te stellen.`)) return;
		btn.disabled = true;
		btn.textContent = "...";

		try {
			const res = await fetch(`${BASE}/${id}`, {
				method: "PATCH",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ mfa_required: true }),
			});
			if (!res.ok) throw new Error("Kon MFA niet inschakelen");
			alert(`MFA ingeschakeld voor ${email}`);
			window.location.reload();
		} catch (err) {
			alert(`Fout: ${err.message}`);
			btn.disabled = false;
			btn.textContent = "Inschakelen";
		}
	};
});

// --- MFA Setup versturen ---
document.querySelectorAll(".btn-mfa-setup").forEach((btn) => {
	btn.onclick = async () => {
		const { id, email } = btn.dataset;
		if (!confirm(`MFA setup-mail (wachtwoord reset) sturen naar ${email}?`)) return;
		btn.disabled = true;
		btn.textContent = "...";
		
		try {
			// Zorg eerst dat mfa_required op true staat
			const patchRes = await fetch(`${BASE}/${id}`, {
				method: "PATCH",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ mfa_required: true }),
			});
			if (!patchRes.ok) {
				const errorData = await patchRes.json();
				throw new Error(errorData.error || "Fout bij bijwerken status");
			}

			// Stuur dan reset mail
			const res = await fetch(`${BASE}/${id}/reset-password`, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: "{}",
			});
			
			const data = await res.json();
			if (res.ok) {
				alert(`Setup-mail verstuurd naar ${email}`);
				window.location.reload();
			} else {
				alert(`Fout: ${data.error || "Onbekende fout bij versturen"}`);
			}
		} catch (err) {
			alert(`Fout: ${err.message}`);
		} finally {
			btn.disabled = false;
			btn.textContent = "Setup sturen";
		}
	};
});

// --- MFA Reset (factoren verwijderen) ---
document.querySelectorAll(".btn-mfa-reset").forEach((btn) => {
	btn.onclick = async () => {
		const { id, email } = btn.dataset;
		if (!confirm(`MFA factoren verwijderen voor ${email}? De medewerker moet MFA opnieuw instellen bij de volgende login.`)) return;
		btn.disabled = true;
		
		const res = await fetch(`${BASE}/${id}/mfa-reset`, {
			method: "POST",
		});
		
		btn.disabled = false;
		if (res.ok) {
			alert(`MFA gereset voor ${email}`);
			window.location.reload();
		} else {
			alert("Fout bij resetten van MFA.");
		}
	};
});

// --- Wachtwoord reset ---
document.querySelectorAll(".btn-reset").forEach((btn) => {
	btn.onclick = async () => {
		const { id, email } = btn.dataset;
		if (!confirm(`Wachtwoord reset sturen naar ${email}?`)) return;
		btn.disabled = true;
		const res = await fetch(`${BASE}/${id}/reset-password`, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: "{}",
		});
		btn.disabled = false;
		const data = await res.json();
		if (!res.ok) alert("Fout: " + data.error);
		else alert(`Reset-mail verstuurd naar ${email}`);
	};
});

// --- Verwijderen ---
document.querySelectorAll(".btn-del").forEach((btn) => {
	btn.onclick = async () => {
		const { id, email } = btn.dataset;
		if (!confirm(`Weet je zeker dat je ${email} wilt verwijderen? Dit kan niet ongedaan worden gemaakt.`)) return;
		const res = await fetch(`${BASE}/${id}`, { method: "DELETE" });
		const data = await res.json();
		if (!res.ok) alert("Fout: " + data.error);
		else {
			btn.closest(".user-row").remove();
			delete pending[id];
			updateSaveBar();
		}
	};
});

// Waarschuw bij pagina verlaten met onopgeslagen wijzigingen
window.addEventListener("beforeunload", (e) => {
	if (countChanges() > 0) {
		e.preventDefault();
		e.returnValue = "";
	}
});
</script>

<style>
.admin-page { padding-top: 80px; min-height: 100vh; background: var(--brand-blue); }
.admin-hero { padding: 5rem 0 9rem; }

/* Paginakop */
.page-header {
	display: flex;
	justify-content: space-between;
	align-items: flex-end;
	margin-bottom: 2.5rem;
}
.back-link {
	display: inline-block;
	margin-bottom: 0.75rem;
	color: rgba(255,255,255,0.6);
	text-decoration: none;
	font-weight: 600;
	font-size: 0.9rem;
	transition: color 0.2s;
}
.back-link:hover { color: white; }
.page-badge {
	display: inline-block;
	background: var(--brand-orange);
	color: white;
	padding: 0.3rem 0.9rem;
	border-radius: 999px;
	font-size: 0.72rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	margin-bottom: 0.5rem;
}
.page-header h1 { color: white; font-size: 2.2rem; margin: 0.3rem 0; }
.page-header p { color: rgba(255,255,255,0.55); font-size: 0.85rem; margin: 0; }

/* Modal */
.modal-overlay {
	position: fixed;
	inset: 0;
	background: rgba(0,0,0,0.6);
	z-index: 1000;
	display: flex;
	align-items: center;
	justify-content: center;
}
.modal-card {
	background: white;
	border-radius: 24px;
	padding: 2.5rem;
	width: 100%;
	max-width: 480px;
	box-shadow: 0 24px 60px rgba(0,0,0,0.3);
}
.modal-card h2 { margin-bottom: 0.5rem; }
.modal-card > p { color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem; }
.form-group { margin-bottom: 1.2rem; }
.form-group label {
	display: block;
	font-weight: 700;
	margin-bottom: 0.4rem;
	font-size: 0.8rem;
	text-transform: uppercase;
	letter-spacing: 0.04em;
	color: var(--brand-blue);
}
.form-group input, .form-group select {
	width: 100%;
	padding: 0.85rem 1rem;
	border-radius: 10px;
	border: 1.5px solid rgba(0,0,0,0.12);
	font-family: inherit;
	font-size: 0.95rem;
	background: #f8fafc;
}
.modal-actions { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem; }
.error-text { color: #dc2626; font-size: 0.875rem; margin-top: 0.5rem; }

/* Gebruikerstabel */
.users-card {
	background: white;
	border-radius: 24px;
	padding: 1.5rem 2rem;
	margin-bottom: 2rem;
	box-shadow: 0 8px 40px rgba(0,0,0,0.15);
	overflow-x: auto;
}
.table-header {
	display: grid;
	grid-template-columns: 2fr 1.2fr 1.8fr 1fr 1.2fr;
	gap: 1rem;
	padding: 0.6rem 1rem;
	background: #f1f5f9;
	border-radius: 10px;
	font-weight: 700;
	font-size: 0.75rem;
	color: var(--brand-blue);
	text-transform: uppercase;
	letter-spacing: 0.05em;
	margin-bottom: 0.5rem;
}
.user-row {
	display: grid;
	grid-template-columns: 2fr 1.2fr 1.8fr 1fr 1.2fr;
	gap: 1rem;
	align-items: center;
	padding: 1rem;
	border-bottom: 1px solid rgba(0,0,0,0.05);
	border-radius: 10px;
	transition: background 0.2s, border 0.2s;
	border: 2px solid transparent;
}
.user-row:last-child { border-bottom: 1px solid transparent; }
.user-row.pending {
	background: #fffbeb;
	border: 2px solid #fbbf24;
}
.user-info { display: flex; align-items: center; gap: 0.75rem; }
.user-avatar {
	width: 36px;
	height: 36px;
	border-radius: 50%;
	background: var(--brand-blue);
