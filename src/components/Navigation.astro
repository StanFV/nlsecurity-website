---
const { pathname } = Astro.url;
const normalizedPathname = pathname.endsWith('/') ? pathname : `${pathname}/`;

const navItems = [
  { href: `${import.meta.env.BASE_URL}/`, label: 'Home' },
  { href: `${import.meta.env.BASE_URL}/oplossingen`, label: 'Oplossingen' },
  { href: `${import.meta.env.BASE_URL}/over`, label: 'Over' },
  { href: `${import.meta.env.BASE_URL}/werken-bij`, label: 'Werken bij' },
];

const isCurrentPage = (href: string) => {
  const normalizedHref = href.endsWith('/') ? href : `${href}/`;
  return normalizedPathname === normalizedHref;
};
---

<nav class="site-nav glass">
  <div class="container nav-content">
    <a href={`${import.meta.env.BASE_URL}/`} class="logo-link">
      <img src={`${import.meta.env.BASE_URL}/assets/images/logo.png`} alt="Logo" class="nav-logo" />
    </a>
    
    <button class="mobile-toggle" aria-label="Toggle menu">
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </button>

    <div class="nav-links">
      <div class="menu-items">
        {navItems.map(item => (
          <a href={item.href} class={isCurrentPage(item.href) ? 'active' : ''}>{item.label}</a>
        ))}
      </div>
      <div class="nav-btns">
        <a href={`${import.meta.env.BASE_URL}/mijn-nl-security`} class="btn-outline portal-btn">Mijn NL Security</a>
        <a href={`${import.meta.env.BASE_URL}/contact`} class="btn-glow">Contact</a>
      </div>
    </div>
  </div>

  <div class="mobile-overlay"></div>
  <div class="mobile-menu">
    <div class="mobile-links">
      {navItems.map(item => (
        <a href={item.href} class={`mobile-link ${isCurrentPage(item.href) ? 'active' : ''}`}>{item.label}</a>
      ))}
      <a href={`${import.meta.env.BASE_URL}/mijn-nl-security`} class="btn-blue">Mijn NL Security</a>
      <a href={`${import.meta.env.BASE_URL}/contact`} class="btn-glow">Contact</a>
    </div>
  </div>
</nav>

<style>
  .btn-blue, .mobile-menu .btn-glow {
    width: 260px;
    padding: 1rem 0;
    border-radius: 50px;
    font-weight: bold;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: 0.3s;
    display: inline-block;
    text-align: center;
    box-sizing: border-box;
    align-self: center;
  }

  .btn-blue {
    background: var(--brand-blue);
    color: white !important;
  }

  .btn-blue:hover {
    filter: brightness(1.2);
    transform: translateY(-2px);
  }

  .site-nav {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    transition: 0.3s;
  }

  /* Overlay */
  .mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0,0,0,0.4);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 998;
  }

  .mobile-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .site-nav.menu-active {
    background: white !important;
    backdrop-filter: none !important;
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo {
    height: 40px;
    transition: 0.3s;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .nav-links {
    display: flex;
    flex: 1;
    margin-left: 3rem;
    align-items: center;
    justify-content: space-between;
  }

  .menu-items {
    display: flex;
    gap: 2.5rem;
  }

  .nav-btns {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: 0.3s;
  }

  .nav-links a.btn-glow, .nav-links a.btn-outline {
    padding: 0.7rem 1.5rem;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    box-sizing: border-box;
    margin: 0;
  }

  .nav-links a.btn-glow {
    color: white;
    border: 2px solid var(--brand-orange); /* Ensure same border box as btn-outline */
  }

  .nav-links a.btn-glow:hover {
    background: white;
    color: var(--brand-orange) !important;
  }

  .portal-btn {
    border-color: var(--brand-blue);
    color: var(--brand-blue);
  }

  .portal-btn:hover {
    background-color: var(--brand-blue);
    color: white !important;
  }

  .portal-link {
    color: var(--brand-orange) !important;
  }

  .nav-links a:not(.btn-glow):hover {
    color: var(--brand-orange);
  }

  .nav-links a.active {
    color: var(--brand-orange);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 2000;
  }

  .hamburger {
    width: 24px;
    height: 18px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--brand-blue);
    border-radius: 2px;
    transition: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    width: 300px;
    height: 100vh;
    background: white;
    padding: 6rem 2rem;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    visibility: hidden;
    transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s 0.4s;
    z-index: 999;
    box-shadow: -10px 0 30px rgba(0,0,0,0.1);
  }

  .mobile-menu.active {
    transform: translateX(0);
    visibility: visible;
    transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    width: 100%;
  }

  .mobile-link {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--brand-blue);
    text-decoration: none;
    width: 100%;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .btn-blue, .btn-glow {
    margin-top: 1rem;
  }

  .mobile-link.active {
    color: var(--brand-orange);
  }

  /* Active Toggle State */
  .mobile-toggle.active .hamburger span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .mobile-toggle.active .hamburger span:nth-child(2) {
    opacity: 0;
  }
  .mobile-toggle.active .hamburger span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .mobile-toggle { display: block; }
    .nav-logo { height: 32px; }
  }
</style>

<script>
  const nav = document.querySelector('.site-nav');
  const toggle = document.querySelector('.mobile-toggle');
  const menu = document.querySelector('.mobile-menu');
  const overlay = document.querySelector('.mobile-overlay');
  const links = document.querySelectorAll('.mobile-link, .btn-blue, .mobile-menu .btn-glow');

  const toggleMenu = () => {
    nav?.classList.toggle('menu-active');
    toggle?.classList.toggle('active');
    menu?.classList.toggle('active');
    overlay?.classList.toggle('active');
    document.body.style.overflow = menu?.classList.contains('active') ? 'hidden' : 'auto';
  };

  const closeMenu = () => {
    nav?.classList.remove('menu-active');
    toggle?.classList.remove('active');
    menu?.classList.remove('active');
    overlay?.classList.remove('active');
    document.body.style.overflow = 'auto';
  };

  toggle?.addEventListener('click', toggleMenu);
  overlay?.addEventListener('click', closeMenu);

  links.forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
